[Unit]
Description=Couchbox HDMI-CEC: register with the TV and claim its input at boot
After=systemd-udev-settle.service
Before=display-manager.service

[Service]
EnvironmentFile=-/etc/couchbox/couchbox.env
ExecCondition=/bin/sh -c 'test "${COUCHBOX_TV_CEC_ENABLED:-1}" = 1'
Type=oneshot
RemainAfterExit=yes
# The CEC device appears a moment after the display driver loads.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do ls /dev/cec* >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/lib/couchbox/bin/couchbox-tv boot

[Install]
WantedBy=multi-user.target
