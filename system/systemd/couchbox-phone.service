[Unit]
Description=Couchbox phone page: type on the TV and use your phone as a remote (port 8791)
After=network-online.target couchboxd.service

[Service]
ExecStart=/usr/lib/couchbox/bin/couchbox-phone
OOMScoreAdjust=-500
RuntimeDirectory=couchbox/phone
RuntimeDirectoryMode=0755
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
