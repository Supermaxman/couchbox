# The journal into the boot screen's log panel, from the switch to the real system until the
# boot screen hands over to the TV session.
[Unit]
Description=Couchbox boot screen: log panel
DefaultDependencies=no
After=systemd-journald.service
Before=plymouth-quit.service
Conflicts=plymouth-quit.service shutdown.target
ConditionPathExists=/run/plymouth/pid

[Service]
ExecStart=/usr/lib/couchbox/bin/couchbox-boot-status log

[Install]
WantedBy=sysinit.target
