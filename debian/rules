#!/usr/bin/make -f
# Couchbox: files are laid out by the top-level Makefile (make install DESTDIR=...).
# Python and data, plus one small C helper (couchbox-screencast, for couchbox-record).
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
# CC and PKG_CONFIG for the host architecture (an arm64 .deb cross-built on a PC, too)
DPKG_EXPORT_BUILDTOOLS = 1
include /usr/share/dpkg/buildtools.mk

%:
	dh $@ --with python3

override_dh_auto_build:
	$(MAKE) helpers

override_dh_auto_clean:
	rm -rf build/helpers

override_dh_auto_test:
	true

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/couchbox

# Started at boot. The TV session itself is only restarted by the updater (see couchbox.updater).
override_dh_installsystemd:
	dh_installsystemd \
	  couchboxd.service couchbox-input.service couchbox-cec.service couchbox-phone.service \
	  couchbox-memory.service couchbox-voice.service couchbox-firstboot.service couchbox-apps.service \
	  couchbox-reencrypt-resume.service couchbox-cloudinit-off.service couchbox-netplan.service couchbox-fan.service couchbox-updater.timer couchbox-clean-caches.timer couchbox-flatpak-update.timer \
	  couchbox-yt-dlp.timer
	dh_installsystemd --no-enable --no-start couchbox-clean-caches.service couchbox-flatpak-update.service couchbox-btlog.service \
	  couchbox-yt-dlp.service
# The updater installs this package from inside these units (and re-encryption must not be cut
# off): an upgrade must not stop them, or dpkg is killed half-way through unpacking.
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade \
	  couchbox-updater.service couchbox-updater-now.service couchbox-reencrypt.service

override_dh_installsystemduser:
	true

override_dh_python3:
	dh_python3 --no-ext-rename

override_dh_fixperms:
	dh_fixperms
	chmod 755 debian/couchbox/usr/lib/couchbox/bin/* debian/couchbox/usr/lib/couchbox/libexec/* debian/couchbox/usr/bin/couchbox
