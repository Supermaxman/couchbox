#!/usr/bin/python3
"""couchbox-memory: keep the box's 8 GB for what's being watched.

Idle apps. Every app is closed after COUCHBOX_APPS_IDLE_MINUTES (couchbox.env, default 60)
without activity: YouTube, Jellyfin, each web app such as Dropout, and any other app started
from the home screen (Twitch, Spotify, Settings, ...: each runs in its own app-*.service or
app-*.scope). An app counts as active while something plays in it, or while it's in front and
the remote is being pressed (couchbox-input touches /run/couchbox/last-key). Closing: web apps
close their Chromium window; the others quit (SIGTERM, then SIGKILL). Their tiles start them
fresh, and the voice assistant's resume picks up where they were. For the other apps, what's in
front and what's playing come from couchbox-mediakeys; while it can't be asked, none is closed.

Out-of-memory order (oom_score_adj, re-applied every check), killed first to last:
  900  apps in the background
  200  the rest of the TV session (Plasma helpers, launcher)
  100  the app in front or playing
 -500  home screen, voice indicator
 -900  KWin, Xwayland, PipeWire audio
  (couchbox-input and couchbox-voice set theirs in their units; system services stay at 0.)
Swap: an 8 GB swap file on the SSD (couchbox-swap) gives the kernel room before it has to kill.

Home screen after an update: the package marks it stale (HOME_STALE), since Plasma keeps running
the old QML; it's reloaded (plasmashell restarted) once the home screen is in front, nothing
plays and the remote has been left alone for HOME_QUIET seconds, so no one sees it happen.

Open files, checked every 10 s. Any TV app past FD_RAISE open files gets its full allowance
(the hard limit), and one still climbing past half of that is logged. libmpv leaks a GL fence
(an open file) per video frame; our player and Jellyfin's delete them, but a leak like it
crashed apps every few minutes at the usual limit ("MESA: error: Export failed", then SIGSEGV).

  couchbox-memory                 run (systemd: couchbox-memory.service), checking every 30 s
  couchbox-memory --status        each app's state and idle time, open files, memory and swap
  couchbox-memory --close NAME    close one app now, as an idle timeout would (youtube, jellyfin, dropout, twitch, ...)
"""
import json
import os
import pwd
import re
import resource
import signal
import subprocess
import sys
import time
import urllib.request

from couchbox.voice import cdp  # noqa: E402

CONF = "/etc/couchbox/couchbox.env"
LAST_KEY = "/run/couchbox/last-key"
STATE = "/run/couchbox/memory/state.json"
CHECK_SECONDS = 30
FILES_SECONDS = 10
HOME_STALE = "/var/lib/couchbox/state/home-stale"
HOME_QUIET = 600
FD_RAISE = 256       # more open files than any app needs: a leak, so give it the full allowance

OOM_BACKGROUND, OOM_SESSION, OOM_ACTIVE = 900, 200, 100
OOM_CORE = {"kwin_wayland": -900, "kwin_wayland_wr": -900, "Xwayland": -900, "pipewire": -900,
            "pipewire-pulse": -900, "wireplumber": -900, "plasmashell": -500, "qml6": -500}

PROBE_JS = ("[document.hasFocus(), [...document.querySelectorAll('video, audio')]"
            ".some(v => !v.paused && !v.ended)]")
JF_PROBE_JS = """(async () => {
  // Jellyfin Desktop plays in mpv, outside the page: ask the TV's own session
  let playing = false;
  try { const a = window.ApiClient, s = a && (await a.getSessions({deviceId: a.deviceId()}))[0];
        playing = !!(s && s.NowPlayingItem && !(s.PlayState || {}).IsPaused); } catch (e) {}
  return [document.hasFocus(), playing];
})()"""


def conf():
    """Settings as COUCHBOX_* environment names (see couchbox.settings.env)."""
    from couchbox import settings
    return settings.env()


def web_names():
    """{host: app name} of the web apps (the apps registry: built-in and the user's websites)."""
    from couchbox import apps, settings
    s = settings.load()
    out = {}
    for a in apps.all_apps(s):
        if a.kind == "web" and a.url:
            out[a.url.split("//", 1)[-1].split("/")[0]] = a.name
    if s["media.jellyfin.url"]:
        out[s["media.jellyfin.url"].split("//", 1)[-1].split("/")[0]] = "Jellyfin"
    return out


def web_name(url, names):
    host = url.split("//", 1)[-1].split("/")[0]
    for h, n in names.items():
        base = h.split(".", 1)[1] if h.count(".") > 1 else h      # watch.dropout.tv -> dropout.tv
        if host == h or host.endswith("." + base) or host == base:
            return n
    return host


# ------------------------------------------------------------------ processes

def procs():
    """[(pid, ppid, comm, uid)] of every process."""
    out = []
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            st = open(f"/proc/{d}/stat").read()
            comm = st[st.index("(") + 1:st.rindex(")")]
            ppid = int(st[st.rindex(")") + 2:].split()[1])
            out.append((int(d), ppid, comm, os.stat(f"/proc/{d}").st_uid))
        except (OSError, ValueError, IndexError):
            pass
    return out


def descendants(root, plist):
    kids, out, todo = {}, [], [root]
    for pid, ppid, _, _ in plist:
        kids.setdefault(ppid, []).append(pid)
    while todo:
        p = todo.pop()
        out.append(p)
        todo += kids.get(p, [])
    return out


def app_procs(uid, plist):
    """{"YouTube": (main pid, [pids]), "Jellyfin": ..., "web": (None, [pids])} of the TV user's apps."""
    comm = {p: c for p, _, c, _ in plist}
    mine = [(p, pp, c) for p, pp, c, u in plist if u == uid]
    out = {}
    yt = [(p, pp) for p, pp, c in mine if c == "vacuumtube"]
    if yt:
        main = next((p for p, pp in yt if comm.get(pp) != "vacuumtube"), yt[0][0])
        out["YouTube"] = (main, [p for p, _ in yt])
    jf = next((p for p, _, c in mine if c == "jellyfin-deskto"), None)
    if jf:
        out["Jellyfin"] = (jf, descendants(jf, plist))
    web = [p for p, _, c in mine if c.startswith("chrome")]
    if web:
        out["web"] = (None, web)
    return out


def unit_of(pid):
    """The systemd unit pid runs in (the last part of its cgroup)."""
    try:
        with open(f"/proc/{pid}/cgroup") as f:
            return f.read().strip().rsplit("/", 1)[-1]
    except OSError:
        return ""


def unit_app(unit):
    """The app id of a unit the home screen started an app in (app-couchbox\\x2dtwitch@<id>.service,
    app-flatpak-<id>-<n>.scope), else "" (KDE's own, autostarted, or not an app)."""
    if not unit.startswith("app-") or "@autostart." in unit or unit.startswith("app-org.kde."):
        return ""
    if unit.endswith(".scope"):
        name = unit[len("app-"):-len(".scope")]
        name = name.removeprefix("flatpak-").rsplit("-", 1)[0]
    elif unit.endswith(".service") and "@" in unit:
        name = unit[len("app-"):].split("@", 1)[0]
    else:
        return ""
    return re.sub(r"\\x([0-9a-f]{2})", lambda m: chr(int(m.group(1), 16)), name)


def launched_apps(uid, plist, covered):
    """{unit: (app id, main pid, [pids])} of the TV user's other apps: those not in `covered`
    (YouTube, Jellyfin and the web apps, which are watched more closely)."""
    parent = {p: pp for p, pp, _, _ in plist}
    pids_of = {}
    for pid, _, _, u in plist:
        if u == uid:
            unit = unit_of(pid)
            if unit_app(unit):
                pids_of.setdefault(unit, []).append(pid)
    out = {}
    for unit, pids in pids_of.items():
        if covered.intersection(pids):
            continue
        roots = [p for p in pids if parent.get(p) not in pids]
        out[unit] = (unit_app(unit), min(roots or pids), sorted(pids))
    return out


def media_state(uid):
    """couchbox-mediakeys's state (the window in front and the players), or None."""
    from couchbox import appctl

    try:
        os.environ.setdefault("XDG_RUNTIME_DIR", f"/run/user/{uid}")
        return appctl.call("mediakeys", {"op": "state"}, timeout=5)
    except Exception:
        return None


def front_and_players(uid):
    """(unit in front, {unit: playing}) from couchbox-mediakeys, or None if it can't be asked."""
    st = media_state(uid)
    if st is None:
        return None
    playing = {}
    for p in st.get("players") or []:
        if p.get("unit"):
            playing[p["unit"]] = playing.get(p["unit"], False) or p.get("effective") == "Playing"
    return (st.get("window") or {}).get("unit", ""), playing


def app_name(app_id):
    """couchbox-twitch -> Twitch, org.example.Foo -> Foo"""
    name = app_id.removeprefix("couchbox-").rsplit(".", 1)[-1]
    return name[:1].upper() + name[1:]


def set_oom(pid, value):
    try:
        with open(f"/proc/{pid}/oom_score_adj", "r+") as f:
            if int(f.read()) != value:
                f.seek(0)
                f.write(str(value))
    except (OSError, ValueError):
        pass


def stop(pid, name, log):
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    for _ in range(100):
        time.sleep(0.1)
        if not os.path.exists(f"/proc/{pid}"):
            return
    log(f"{name} didn't quit; killing it")
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


# ------------------------------------------------------------------ open files

def fd_table(pid):
    """Size of pid's file table: at least its highest open file. Cheap, unlike counting them."""
    with open(f"/proc/{pid}/status") as f:
        for line in f:
            if line.startswith("FDSize:"):
                return int(line.split()[1])
    return 0


def open_files(pid):
    return len(os.listdir(f"/proc/{pid}/fd"))


def guard_files(uid, plist, warned, log):
    """Give the TV user's processes past FD_RAISE open files their hard limit; log any past half
    of it (again at each further 20%). Returns {pid: (name, files, limit)} of those checked."""
    out = {}
    for pid, _, comm, u in plist:
        if u != uid:
            continue
        try:
            if fd_table(pid) <= FD_RAISE:
                continue
            n = open_files(pid)
            soft, hard = resource.prlimit(pid, resource.RLIMIT_NOFILE)
            if n > FD_RAISE and soft < hard:
                resource.prlimit(pid, resource.RLIMIT_NOFILE, (hard, hard))
                log(f"{comm} ({pid}) has {n} open files: raised its limit from {soft} to {hard}")
                soft = hard
            if n > soft // 2 and n > warned.get(pid, 0) * 1.2:
                log(f"{comm} ({pid}) has {n} of {soft} open files: leaking? it will crash at the limit")
                warned[pid] = n
            out[pid] = (comm, n, soft)
        except (OSError, ValueError):
            pass        # gone, or a process we can't touch
    for pid in [p for p in warned if p not in out]:
        del warned[pid]
    return out


# ------------------------------------------------------------------ apps

def probe():
    """{app key: {name, focus, playing, page}} of the apps open now."""
    names, out = web_names(), {}
    for port, name, js in ((cdp.YOUTUBE_PORT, "YouTube", PROBE_JS), (cdp.JELLYFIN_PORT, "Jellyfin", JF_PROBE_JS)):
        pages = cdp.pages(port)
        if pages:
            focus = playing = False
            for p in pages:
                try:
                    f, pl = cdp.evaluate(p, js, timeout=5)
                    focus, playing = focus or f, playing or pl
                except Exception:
                    pass
            out[name] = {"name": name, "focus": focus, "playing": playing}
    for p in cdp.pages(cdp.WEB_PORT):
        try:
            focus, playing = cdp.evaluate(p, PROBE_JS, timeout=5)
        except Exception:
            focus = playing = False
        out["web:" + p["id"]] = {"name": web_name(p["url"], names), "focus": focus, "playing": playing, "page": p["id"]}
    return out


def open_apps(uid, plist):
    """Every open app as ({key: {name, focus, playing}}, {key: (main pid, [pids])})."""
    groups = app_procs(uid, plist)
    apps = probe()
    covered = {p for _, pids in groups.values() for p in pids}
    others = launched_apps(uid, plist, covered)
    seen = front_and_players(uid) if others else None
    front, playing = seen or ("", {})
    for unit, (app_id, main, pids) in others.items():
        k = "app:" + unit
        # couchbox-mediakeys not answering: count it as playing, so nothing is closed blind
        apps[k] = {"name": app_name(app_id), "focus": front == unit, "playing": seen is None or playing.get(unit, False)}
        groups[k] = (main, pids)
    return apps, groups


def close(key, app, main_pids, log):
    if key.startswith("web:"):
        try:
            urllib.request.urlopen(f"http://127.0.0.1:{cdp.WEB_PORT}/json/close/{app['page']}", timeout=5).read()
        except OSError as err:
            log(f"couldn't close {app['name']}: {err}")
    elif main_pids.get(key):
        stop(main_pids[key], app["name"], log)


class Memory:
    def __init__(self):
        c = conf()
        self.idle = int(c.get("COUCHBOX_APPS_IDLE_MINUTES") or 60) * 60
        self.uid = pwd.getpwnam(c.get("COUCHBOX_TV_USER") or "tv").pw_uid
        self.last_active = {}       # app key -> time it was last active
        self.last_key = self.key_time()
        self.warned = {}            # pid -> open files when last logged
        self.files = {}

    @staticmethod
    def key_time():
        try:
            return os.stat(LAST_KEY).st_mtime
        except OSError:
            return 0.0

    def log(self, msg):
        print(msg, flush=True)

    def check(self):
        now = time.time()
        key = self.key_time()
        pressed, self.last_key = key > self.last_key, key
        plist = procs()
        apps, groups = open_apps(self.uid, plist)
        for k in list(self.last_active):
            if k not in apps:
                del self.last_active[k]
        for k, a in apps.items():
            if k not in self.last_active or a["playing"] or (a["focus"] and pressed):
                self.last_active[k] = now
            a["idle"] = int(now - self.last_active[k])

        if os.path.exists(HOME_STALE):
            self.reload_home(apps, now - key)
        mains = {n: g[0] for n, g in groups.items()}
        for k, a in apps.items():
            if a["idle"] > self.idle:
                self.log(f"closing {a['name']}: idle {a['idle'] // 60} min")
                close(k, a, mains, self.log)
                self.last_active.pop(k, None)
                a["closed"] = True

        # out-of-memory order
        active = {("web" if k.startswith("web:") else k) for k, a in apps.items()
                  if not a.get("closed") and (a["focus"] or a["playing"])}
        in_apps = set()
        for name, (_, pids) in groups.items():
            value = OOM_ACTIVE if name in active else OOM_BACKGROUND
            for p in pids:
                set_oom(p, value)
                in_apps.add(p)
        for pid, _, comm, uid in plist:
            if uid == self.uid and pid not in in_apps:
                set_oom(pid, OOM_CORE.get(comm, OOM_SESSION))

        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE + ".tmp", "w") as f:
            json.dump({"t": now, "idle_limit": self.idle, "apps": apps, "files": self.files}, f)
        os.replace(STATE + ".tmp", STATE)

    def reload_home(self, apps, quiet):
        """Restart plasmashell for the updated home screen, if no one would notice."""
        if quiet < HOME_QUIET or any(a["playing"] for a in apps.values()):
            return
        st = media_state(self.uid)
        if not st or not (st.get("window") or {}).get("shell"):
            return
        if any(p.get("effective") == "Playing" for p in st.get("players") or []):
            return
        from couchbox import home
        self.log("reloading the home screen after an update")
        home.restart_plasmashell()
        try:
            os.unlink(HOME_STALE)
        except OSError:
            pass

    def run(self):
        self.log(f"couchbox-memory: closing apps idle for {self.idle // 60} min; checking every {CHECK_SECONDS} s")
        tick = 0
        while True:
            try:
                self.files = guard_files(self.uid, procs(), self.warned, self.log)
                if tick % (CHECK_SECONDS // FILES_SECONDS) == 0:
                    self.check()
            except Exception as err:      # never stop: log and try again next time
                self.log(f"check failed: {err!r}")
            tick += 1
            time.sleep(FILES_SECONDS)


def status():
    try:
        s = json.load(open(STATE))
    except OSError:
        sys.exit("couchbox-memory isn't running (sudo systemctl status couchbox-memory)")
    print(f"apps (closed after {s['idle_limit'] // 60} min idle; checked {int(time.time() - s['t'])} s ago):")
    for a in s["apps"].values():
        what = "playing" if a["playing"] else "in front" if a["focus"] else "background"
        print(f"  {a['name']:<12} {what:<10} idle {a['idle'] // 60} min" + ("  (closed)" if a.get("closed") else ""))
    if not s["apps"]:
        print("  none open")
    if s.get("files"):
        print(f"\nopen files (processes past {FD_RAISE}):")
        for pid, (comm, n, limit) in sorted(s["files"].items(), key=lambda kv: -kv[1][1]):
            print(f"  {comm:<16} {pid:>8}  {n} of {limit}")
    print()
    subprocess.run(["free", "-h"])


def close_now(name):
    apps, groups = open_apps(pwd.getpwnam(conf().get("COUCHBOX_TV_USER") or "tv").pw_uid, procs())
    mains = {n: g[0] for n, g in groups.items()}
    hits = [(k, a) for k, a in apps.items() if a["name"].lower() == name.lower()]
    if not hits:
        sys.exit(f"{name} isn't open")
    for k, a in hits:
        close(k, a, mains, print)
        print(f"closed {a['name']}")


def main():
    args = sys.argv[1:]
    if not args:
        Memory().run()
    elif args[0] == "--status":
        status()
    elif args[0] == "--close" and len(args) == 2:
        if os.geteuid() != 0:
            os.execvp("sudo", ["sudo", sys.argv[0]] + args)
        close_now(args[1])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
