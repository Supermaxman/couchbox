#!/usr/bin/python3
"""couchbox-mediakeys: the remote's media keys for whatever is playing (couchbox.mediakeys).

Runs in the TV session (couchbox-mediakeys.service). couchbox-input sends it each Play/Pause,
Rewind, Fast-forward, Next and Previous press; it picks the player (the app in front's, else
what's playing, else what was paused last) and calls it over MPRIS.

  couchbox-mediakeys              serve (the TV user's service)
  couchbox-mediakeys state        the players it knows and the window in front
  couchbox-mediakeys ACTION       press a key: playpause, play, pause, stop, next, previous,
                                  rewind, forward
"""
import json
import sys

from couchbox import appctl, mediakeys


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if not arg:
        mediakeys.serve()
        return 0
    if arg == "state" or arg in mediakeys.ACTIONS:
        req = {"op": "state"} if arg == "state" else {"op": "key", "action": arg}
        try:
            print(json.dumps(appctl.call(mediakeys.SITE, req, timeout=5), indent=1))
        except appctl.NotRunning:
            print("couchbox-mediakeys isn't running", file=sys.stderr)
            return 1
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
