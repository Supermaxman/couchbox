#!/usr/bin/env bash
# couchbox-wifi-watch: brings the Wi-Fi back when it stops working and doesn't recover by itself.
# Once a minute it pings the router. Access points can leave the Pi's Wi-Fi associated but dead:
# the link looks up, no traffic flows, and NetworkManager never notices (a box sat six hours like
# that after "brcmfmac: External authentication failed"). After RECONNECT minutes with no answer it
# reconnects through NetworkManager; if the router still doesn't answer FIRM minutes in, it
# reloads the Wi-Fi driver (that resets the chip's firmware). After that it waits PAUSE minutes
# before starting over. Every step is logged: journalctl -u couchbox-wifi-watch
#
# It only acts on a router it has seen answer pings before (some don't answer them at all), only
# while Wi-Fi is the way out (no Ethernet), the Wi-Fi is switched on and a Wi-Fi network is saved.
# A disconnected Wi-Fi counts as no answer, so a NetworkManager that gave up is retried too.
# Run by couchbox-wifi-watch.service.
set -uo pipefail
[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"

CHECK=60 RECONNECT=3 FIRM=5 PAUSE=10
STATE=/var/lib/couchbox/state/wifi-watch-router   # the last router that answered a ping

log() { echo "wifi-watch: $*"; }
nm_connect() { nmcli --wait 60 device connect "$1" 2>&1 | sed 's/\x1b\[[0-9;]*[A-Za-z]//g; s/\r//g'; }   # (minus its progress line)

wifi_device() { nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | awk -F: '$2 == "wifi" { print $1 ":" $3; exit }'; }

reconnect() {
  log "reconnecting $1 through NetworkManager"
  nmcli --wait 20 device disconnect "$1" >/dev/null 2>&1
  if out=$(nm_connect "$1"); then log "reconnected: $out"
  else log "reconnect failed: $out"; fi
}

firm_restart() {
  local dev=$1 mod holders
  mod=$(basename "$(readlink -f "/sys/class/net/$dev/device/driver/module" 2>/dev/null)" 2>/dev/null)
  if [[ -n $mod && -d /sys/module/$mod ]]; then
    holders=$(find "/sys/module/$mod/holders" -mindepth 1 -maxdepth 1 -printf "%f " 2>/dev/null)
    log "restarting the Wi-Fi: reloading its driver ($holders$mod)"
    # shellcheck disable=SC2086  # holders: a list of module names
    if modprobe -r $holders "$mod"; then
      sleep 2
      # shellcheck disable=SC2086
      modprobe -a "$mod" $holders || log "couldn't load $mod again"
    else
      log "couldn't unload $mod; switching the Wi-Fi off and on instead"
      nmcli radio wifi off; sleep 3; nmcli radio wifi on
    fi
  else
    log "restarting the Wi-Fi: switching it off and on"
    nmcli radio wifi off; sleep 3; nmcli radio wifi on
  fi
  for _ in $(seq 30); do [[ -e /sys/class/net/$dev ]] && break; sleep 1; done
  sleep 5
  if out=$(nm_connect "$dev"); then log "Wi-Fi back: $out"
  else log "Wi-Fi didn't connect yet: $out"; fi
}

misses=0 down=""   # minutes without an answer; when that began
while true; do
  sleep "$CHECK"
  IFS=: read -r dev state <<<"$(wifi_device)"
  if [[ -z ${dev:-} ]] \
     || [[ $(nmcli radio wifi 2>/dev/null) != enabled ]] \
     || nmcli -t -f TYPE,STATE device 2>/dev/null | grep -qx 'ethernet:connected' \
     || ! nmcli -t -f TYPE connection show 2>/dev/null | grep -qx '802-11-wireless'; then
    misses=0 down=""; continue   # no Wi-Fi, switched off, on Ethernet, or never set up: nothing to watch
  fi
  router=""
  [[ $state == connected ]] && router=$(ip -4 route show default dev "$dev" 2>/dev/null | awk '{ print $3; exit }')
  if [[ -n $router ]] && ping -q -n -c 3 -W 2 -I "$dev" "$router" >/dev/null 2>&1; then
    [[ -n $down ]] && log "router $router answers again, after $(( (SECONDS - down + 30) / 60 )) min"
    down=""
    [[ $(cat "$STATE" 2>/dev/null) == "$router" ]] || echo "$router" > "$STATE"
    misses=0; continue
  fi
  # connected to a router that never answered pings here: can't tell, leave it alone
  [[ -n $router && $(cat "$STATE" 2>/dev/null) != "$router" ]] && { misses=0 down=""; continue; }
  # (disconnected before any router ever answered: the box is still being set up)
  [[ -s $STATE ]] || { misses=0 down=""; continue; }
  misses=$(( misses + 1 ))
  if [[ -z $down ]]; then
    down=$SECONDS
    if [[ -n $router ]]; then log "router $router doesn't answer"; else log "Wi-Fi $dev is $state"; fi
  fi
  if (( misses == RECONNECT )); then reconnect "$dev"
  elif (( misses == FIRM )); then firm_restart "$dev"; misses=$(( -PAUSE ))
  fi
done
