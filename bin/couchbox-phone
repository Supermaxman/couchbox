  html, body { margin: 0; background: var(--bg); }
  body { color: var(--text); font: 16px/1.3 -apple-system, system-ui, sans-serif; -webkit-user-select: none; user-select: none;
         padding: max(14px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right))
                  max(20px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left)); }
  main { max-width: 440px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
  button { font: inherit; color: var(--text); background: var(--card); border: 1px solid var(--line);
           border-radius: 14px; padding: 0; min-height: 52px; touch-action: manipulation; cursor: pointer;
           display: flex; align-items: center; justify-content: center; gap: 6px; transition: transform .06s, background .06s; }
  button:active, button.down { background: var(--card2); transform: scale(0.96); }
