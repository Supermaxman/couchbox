  .dpad { position: relative; width: min(76vw, 290px); aspect-ratio: 1; border-radius: 50%;
          background: radial-gradient(circle at 50% 40%, #1f2650, var(--card)); border: 1px solid var(--line);
          box-shadow: 0 10px 30px rgba(0,0,0,.35); }
