#!/usr/bin/python3
"""couchbox-phone: type on the TV from a phone.

Serves a small page on port 8791 (home network and tailnet only). Phones pair by scanning the
QR code on the TV: its address carries a token (#t=..., kept by the page; Settings → Remote
access → New pairing code signs phones out). Phones that can't scan (an iPhone home-screen
app keeps its own storage) type the 8-character code shown under the QR instead; /pair trades
it for the token. Without the token the page can't send anything. Text sent from it goes
into whatever field is selected on the TV: web apps, YouTube and Jellyfin through DevTools
(any characters), anything else (the home screen, our TV apps) as key presses (US keyboard).
The page also has the remote's buttons: arrows, OK, Back, Home, Play/Pause.

Send to TV: a link pasted on the page (or shared to the iPhone Shortcut the page explains how to
make, which posts it the same way) opens in its app on the TV: YouTube, Twitch, Nebula, Dropout,
Jellyfin, else the Search app's web view (couchbox.links). POST /send {"url": ...} with the
X-Couchbox-Token header, SEND_LIMIT a minute.

Moments (couchbox.moments): a button each starts one on the TV, and Stop stops the one playing
(POST /moments lists them, /moments/start {"id"}, /moments/stop); the voice service plays them.

The page's Enter (and "Type + Enter") is the keypad Enter key, so our TV apps' keyboard
pop-up can tell "done typing" from the remote's OK (Return). Its address as a QR code, for
the pop-up to show: /run/couchbox/phone/phone.png and phone.url. They use https://<tailnet name>
(tailscale serve proxies 443 to this port, with a real certificate; set up by couchbox-update),
else http://couchbox.local:8791. Not plain "couchbox": the home router's DNS can hold a stale address.

  couchbox-phone                 run the server (systemd: couchbox-phone.service)
  couchbox-phone "some text"     type it on the TV now
  couchbox-phone --send URL      open a link on the TV now, as Send to TV does
"""
import hmac
import ipaddress
import json
import os
import socket
import subprocess
import sys
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

from evdev import UInput, ecodes as e

from couchbox import links, secrets, settings  # noqa: E402
from couchbox.voice import cdp, tools  # noqa: E402

PORT = 8791
VOICE = "http://127.0.0.1:8790"            # couchbox-voice: plays Moments
LAST_KEY = "/run/couchbox/last-key"      # couchbox-memory: someone is using the TV
PHONE_DIR = "/run/couchbox/phone"           # phone.url, phone.png (systemd RuntimeDirectory)
TAILNET = ipaddress.ip_network("100.64.0.0/10")
PAIR_TRIES = 5            # wrong pairing codes allowed per minute, from anyone
_pair_fails: list[float] = []
_pair_lock = threading.Lock()
SEND_LIMIT = 10           # links sent to the TV per minute, from all phones together
SEND_BODY = 16384         # bytes: a link and nothing much else
_sends: list[float] = []
_send_lock = threading.Lock()
_opening = threading.Lock()   # one link opens at a time

# US layout: character -> (key, shift)
CHARS = {c: (getattr(e, f"KEY_{c.upper()}"), c.isupper()) for c in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"}
CHARS.update({str(d): (getattr(e, f"KEY_{d}"), False) for d in range(10)})
for c, k in zip(")!@#$%^&*(", "0123456789"):
    CHARS[c] = (getattr(e, f"KEY_{k}"), True)
for plain, shifted, key in [("-", "_", e.KEY_MINUS), ("=", "+", e.KEY_EQUAL), ("[", "{", e.KEY_LEFTBRACE),
                            ("]", "}", e.KEY_RIGHTBRACE), ("\\", "|", e.KEY_BACKSLASH), (";", ":", e.KEY_SEMICOLON),
                            ("'", '"', e.KEY_APOSTROPHE), ("`", "~", e.KEY_GRAVE), (",", "<", e.KEY_COMMA),
                            (".", ">", e.KEY_DOT), ("/", "?", e.KEY_SLASH)]:
    CHARS[plain], CHARS[shifted] = (key, False), (key, True)
CHARS[" "], CHARS["\t"], CHARS["\n"] = (e.KEY_SPACE, False), (e.KEY_TAB, False), (e.KEY_KPENTER, False)

KEYS = {"up": e.KEY_UP, "down": e.KEY_DOWN, "left": e.KEY_LEFT, "right": e.KEY_RIGHT, "ok": e.KEY_ENTER,
        "enter": e.KEY_KPENTER, "back": e.KEY_ESC, "home": e.KEY_HOMEPAGE, "play": e.KEY_PLAYPAUSE,
        "tab": e.KEY_TAB, "backspace": e.KEY_BACKSPACE, "menu": e.KEY_MENU}

_ui = None


def ui():
    """The virtual keyboard, made on first use (the page still serves without one: tests,
    containers without /dev/uinput)."""
    global _ui
    if _ui is None:
        _ui = UInput({e.EV_KEY: sorted({k for k, _ in CHARS.values()} | set(KEYS.values()) |
                                       {e.KEY_LEFTSHIFT, e.KEY_LEFTCTRL, e.KEY_A})}, name="couchbox-phone")
    return _ui


def used():
    try:
        open(LAST_KEY, "a").close()
        os.utime(LAST_KEY)
    except OSError:
        pass


# Apps read keys from the Wayland compositor at frame rate: a press and release in the same
# instant, or the next key right behind, can be lost (double letters and Shift first). Hold each
# key for a moment and leave a gap; about 25 characters a second.
HOLD, GAP = 0.012, 0.028
_keys = threading.Lock()       # one key at a time
_typing = threading.Lock()     # one text at a time, so two sends never interleave


def tap(key, shift=False, ctrl=False):
    mods = [m for m, on in ((e.KEY_LEFTSHIFT, shift), (e.KEY_LEFTCTRL, ctrl)) if on]
    k = ui()
    with _keys:
        if mods:
            for m in mods:
                k.write(e.EV_KEY, m, 1)
            k.syn()
            time.sleep(HOLD)
        k.write(e.EV_KEY, key, 1)
        k.syn()
        time.sleep(HOLD)
        k.write(e.EV_KEY, key, 0)
        k.syn()
        if mods:
            time.sleep(HOLD)
            for m in mods:
                k.write(e.EV_KEY, m, 0)
            k.syn()
        time.sleep(GAP)


def type_text(text):
    """Type into the selected field on the TV. Returns how it was typed."""
    used()
    kind, _ = tools.typing_target()
    if kind == "youtube":                      # YouTube's search screen has no real text box
        tools.youtube("search", query=text)
        return "searched"
    _, page = tools.foreground(focused=True)   # else a non-web app (Seerr app...): type as a keyboard
    if page:
        try:
            cdp.send(page, "Input.insertText", {"text": text})
            return "typed"
        except Exception:
            pass
    missing = sorted({c for c in text if c not in CHARS})
    with _typing:
        for c in text:
            if c in CHARS:
                tap(*CHARS[c])
    return "typed" + (f" (couldn't type {''.join(missing)})" if missing else "")


def press(name):
    used()
    if name == "clear":                       # empty the selected field: select all, delete
        tap(e.KEY_A, ctrl=True)
        tap(e.KEY_BACKSPACE)
    elif name in KEYS:
        tap(KEYS[name])
    else:
        return f"unknown key {name}"
    return "ok"


