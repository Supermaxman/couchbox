<meta name="apple-mobile-web-app-title" content="TV remote">
<title>TV remote</title>
<script>
  // pairing: the TV's QR code opens this page with #t=<token>; keep it, and tidy the address bar
  (() => { const m = location.hash.match(/t=([A-Za-z0-9_-]+)/);
           if (m) { try { localStorage.setItem("couchbox-token", m[1]); } catch (e) {} history.replaceState(null, "", location.pathname); } })();
  window.TOKEN = (() => { try { return localStorage.getItem("couchbox-token") || ""; } catch (e) { return ""; } })();
</script>
<style>
  :root { color-scheme: dark; --bg: #0e1222; --card: #181e3c; --card2: #222a52; --line: #2c3566;
