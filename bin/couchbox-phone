<script>
const t = document.getElementById("t"), msg = document.getElementById("msg"), eye = document.getElementById("eye");
let msgTimer;
eye.onclick = () => { const hide = t.type === "text"; t.type = hide ? "password" : "text"; eye.classList.toggle("on", hide); t.focus(); };
t.addEventListener("keydown", ev => { if (ev.key === "Enter") { ev.preventDefault(); send(true); } });
function say(text) {
  msg.textContent = text; msg.style.opacity = 1;
  clearTimeout(msgTimer); msgTimer = setTimeout(() => { msg.style.opacity = 0; }, 2500);
}
const pairBox = document.getElementById("pair"), code = document.getElementById("code");
function needPairing(text) { pairBox.classList.add("on"); if (text) say(text); }
if (!window.TOKEN) needPairing();
async function pairWithCode() {
  if (!code.value.trim()) { code.focus(); return; }
  try {
    const r = await fetch("/pair", {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify({code: code.value})});
    const res = await r.json();
    if (!res.token) { say(res.result); return; }
    window.TOKEN = res.token;
    try { localStorage.setItem("couchbox-token", res.token); } catch (e) {}
    document.getElementById("tok").value = res.token;
    code.value = ""; code.blur(); pairBox.classList.remove("on"); say("Paired.");
  } catch (err) { say("The TV isn't answering."); }
}
async function post(path, body, quiet) {
  if (!window.TOKEN) { needPairing("Pair this phone first."); return; }
  try {
    const r = await fetch(path, {method: "POST", headers: {"Content-Type": "application/json", "X-Couchbox-Token": window.TOKEN},
                                 body: JSON.stringify(body)});
    if (r.status === 401) { needPairing("This phone isn't paired any more. Scan the QR code or type the code from the TV."); return; }
    const res = (await r.json()).result;
    if (!quiet || res !== "Sent.") say(res);
  } catch (err) { say("The TV isn't answering."); }
}
function send(enter) {
  if (!t.value && !enter) return;
  post("/type", {text: t.value, enter});
  t.value = "";
}
// remote keys: tap sends one press; holding an arrow or backspace repeats
for (const b of document.querySelectorAll("[data-key]")) {
  let delay, rep;
  const stop = () => { clearTimeout(delay); clearInterval(rep); b.classList.remove("down"); };
  b.addEventListener("pointerdown", ev => {
    ev.preventDefault();
    b.classList.add("down");
    if (navigator.vibrate) navigator.vibrate(8);
    post("/key", {key: b.dataset.key}, true);
    if (b.hasAttribute("data-repeat"))
      delay = setTimeout(() => { rep = setInterval(() => post("/key", {key: b.dataset.key}, true), 110); }, 420);
  });
  for (const e of ["pointerup", "pointerleave", "pointercancel"]) b.addEventListener(e, stop);
  b.addEventListener("contextmenu", ev => ev.preventDefault());
}
// Moments: a button each starts it on the TV; Stop stops the one playing
const momentsCard = document.getElementById("momentscard"), momentsBox = document.getElementById("moments"),
      stopMoment = document.getElementById("stopmoment"), momentMsg = document.getElementById("momentmsg");
async function momentCall(path, body) {
  if (!window.TOKEN) return null;
  try {
    const r = await fetch(path, {method: "POST", headers: {"Content-Type": "application/json", "X-Couchbox-Token": window.TOKEN},
                                 body: JSON.stringify(body || {})});
    return r.ok ? await r.json() : null;
  } catch (e) { return null; }
}
async function loadMoments() {
  const r = await momentCall("/moments");
  if (!r) return;
  momentsCard.hidden = !r.moments.length;
  momentsBox.replaceChildren(...r.moments.map(m => {
    const b = document.createElement("button");
    const on = m.id === r.active;
    b.className = on ? "on" : "";
    b.append(m.name);
    const sub = document.createElement("small");
    sub.textContent = on ? "Playing" : m.plays;
    b.append(sub);
    b.onclick = async () => {
      momentMsg.textContent = "Starting " + m.name + "…";
      const res = await momentCall("/moments/start", {id: m.id});
      momentMsg.textContent = res ? res.result : "The TV isn't answering.";
      loadMoments();
    };
    return b;
  }));
  const playing = r.moments.find(m => m.id === r.active);
  stopMoment.hidden = !playing;
  if (playing) stopMoment.textContent = "Stop " + playing.name;
}
stopMoment.onclick = async () => {
  const res = await momentCall("/moments/stop");
  momentMsg.textContent = res ? res.result : "The TV isn't answering.";
  loadMoments();
};
loadMoments();
setInterval(() => { if (!document.hidden) loadMoments(); }, 10000);
document.addEventListener("visibilitychange", () => { if (!document.hidden) loadMoments(); });
// Send to TV: a link opens in its app on the TV (it can take a while if the app has to start)
const link = document.getElementById("link"), sendBtn = document.getElementById("sendbtn"),
      sendMsg = document.getElementById("sendmsg"), paste = document.getElementById("paste");
async function sendLink() {
  if (!link.value.trim()) { link.focus(); return; }
  if (!window.TOKEN) { needPairing("Pair this phone first."); return; }
  sendBtn.disabled = true; sendMsg.className = ""; sendMsg.textContent = "Sending…";
  try {
    const r = await fetch("/send", {method: "POST", headers: {"Content-Type": "application/json", "X-Couchbox-Token": window.TOKEN},
                                    body: JSON.stringify({url: link.value.trim()})});
    if (r.status === 401) { sendMsg.textContent = ""; needPairing("This phone isn't paired any more. Scan the QR code or type the code from the TV."); return; }
    const res = await r.json();
    sendMsg.textContent = res.result; sendMsg.className = res.ok ? "ok" : "bad";
    if (res.ok) { link.value = ""; link.blur(); }
  } catch (err) { sendMsg.textContent = "The TV isn't answering."; sendMsg.className = "bad"; }
  finally { sendBtn.disabled = false; }
}
if (navigator.clipboard && navigator.clipboard.readText && window.isSecureContext) {
  paste.hidden = false;
  paste.onclick = async () => { try { link.value = (await navigator.clipboard.readText()).trim(); } catch (e) { link.focus(); } };
}
// the Shortcut's address and key (this page's own, so the shortcut reaches the TV the same way)
document.getElementById("endpoint").value = location.origin + "/send";
document.getElementById("tok").value = window.TOKEN;
for (const b of document.querySelectorAll("[data-copy]")) b.onclick = async () => {
  const el = document.getElementById(b.dataset.copy);
  if (!el.value) { needPairing("Pair this phone first."); return; }
  try { await navigator.clipboard.writeText(el.value); }
  catch (e) {          // plain http (couchbox.local): no clipboard API, copy the selection instead
    const type = el.type; el.type = "text"; el.select(); el.setSelectionRange(0, el.value.length);
    document.execCommand("copy"); el.type = type; el.blur();
  }
  b.textContent = "Copied"; setTimeout(() => { b.textContent = "Copy"; }, 1500);
};
</script></body></html>
"""


SPOTIFY_PAGE = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1"><title>Spotify on the TV</title>
<style>body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0b0b0d;color:#fafafa;
font:18px/1.4 -apple-system,system-ui,sans-serif;padding:24px;box-sizing:border-box;text-align:center}p{max-width:420px}</style>
</head><body><p>__MSG__</p></body></html>"""


class Handler(BaseHTTPRequestHandler):
    def allowed(self):
        ip = ipaddress.ip_address(self.client_address[0])
        ip = getattr(ip, "ipv4_mapped", None) or ip
        if ip.is_private or ip.is_loopback or ip in TAILNET:
            return True
        self.send_error(403)
        return False

    def reply(self, code, body, ctype="application/json"):
        data = body.encode() if isinstance(body, str) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if not self.allowed():
            return
        if self.path.split("?", 1)[0] in ("/spotify/login", "/spotify/callback"):
            return self.spotify()
        self.reply(200, PAGE, "text/html; charset=utf-8")

    def spotify(self):
        """Signing in to Spotify from a phone (the Spotify app on the TV shows the QR code):
        /spotify/login goes to Spotify's sign-in page, /spotify/callback is where Spotify sends
        the phone back (over Tailscale's https) with the code, handed to the app to finish."""
        from urllib.parse import parse_qs, urlparse

        from couchbox import appctl
        path, q = self.path.split("?", 1)[0], parse_qs(urlparse(self.path).query)
        fn = "login_url" if path == "/spotify/login" else "login_finish"
        args = {k: q[k][0] for k in ("code", "state", "error") if q.get(k)}
        res = None
        for site in ("spotify", "spotify-connect"):       # the app, or its background service
            try:
                res = appctl.call(site, {"op": "call", "fn": fn, "args": args}, timeout=30)
                break
            except appctl.NotRunning:
                continue
            except Exception as err:  # noqa: BLE001
                res = {"error": str(err)}
                break
        if res is None:
            res = {"error": "Open Spotify on the TV (Setup, step 5), then scan the code again."}
        if fn == "login_url" and res.get("url"):
            self.send_response(302)
            self.send_header("Location", res["url"])
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            return
        ok = not res.get("error")
        msg = (f"Signed in to Spotify as {res.get('user') or 'you'}. You can close this page." if ok and fn == "login_finish"
               else res.get("error") or "Something went wrong.")
        import html
        self.reply(200 if ok else 400, SPOTIFY_PAGE.replace("__MSG__", html.escape(msg)), "text/html; charset=utf-8")

    def paired(self):
        """The phone's token, or our own programs on this box (voice dictation)."""
        ip = ipaddress.ip_address(self.client_address[0])
        ip = getattr(ip, "ipv4_mapped", None) or ip
        if ip.is_loopback and self.headers.get("X-Couchbox") == "1" and not self.headers.get("X-Forwarded-For"):
            return True
        token = secrets.get("phone.token")
        given = self.headers.get("X-Couchbox-Token", "")
        if token and given and hmac.compare_digest(token, given):
            return True
        self.reply(401, {"result": "Not paired."})
        return False

    def pair(self):
        """POST /pair {code}: the code from Settings → Remote access, for phones that can't
        scan the QR (an iPhone home-screen app). Replies with the token. Wrong codes are
        limited to PAIR_TRIES a minute so nobody can guess through them."""
        with _pair_lock:
            now = time.monotonic()
            _pair_fails[:] = [t for t in _pair_fails if now - t < 60]
            if len(_pair_fails) >= PAIR_TRIES:
                return self.reply(429, {"result": "Too many tries. Wait a minute."})
            try:
                body = json.loads(self.rfile.read(min(int(self.headers.get("Content-Length") or 0), 1024)) or b"{}")
            except ValueError:
                body = {}
            token = secrets.check_pair_code(str(body.get("code", "")))
            if not token:
                _pair_fails.append(now)
                print(f"{self.client_address[0]} /pair wrong code", flush=True)
                return self.reply(403, {"result": "That code doesn't match. Check Settings → Remote access on the TV."})
        print(f"{self.client_address[0]} /pair paired", flush=True)
        self.reply(200, {"result": "Paired.", "token": token})

    def send_link(self):
        """POST /send {"url": ...} ("text" also works: Android shares text): open a link on the
        TV in its app (couchbox.links). The page's Send to TV box and the iPhone Shortcut use it.
        Like every call it needs the token in the X-Couchbox-Token header (checked before this):
        a header, never a cookie, so another web page can't send for a phone that has the page
        open (a browser only adds headers across sites after asking us, and we never agree).
        At most SEND_LIMIT links a minute and one at a time; each is logged."""
        if self.headers.get("Content-Type", "").split(";")[0].strip().lower() != "application/json":
            return self.reply(415, {"ok": False, "result": 'Send JSON: {"url": "https://..."}.'})
        size = int(self.headers.get("Content-Length") or 0)
        if size > SEND_BODY:
            return self.reply(413, {"ok": False, "result": "That's too long for a link."})
        with _send_lock:
            now = time.monotonic()
            _sends[:] = [t for t in _sends if now - t < 60]
            if len(_sends) >= SEND_LIMIT:
                return self.reply(429, {"ok": False, "result": "That's a lot of links. Wait a minute."})
            _sends.append(now)
        try:
            body = json.loads(self.rfile.read(size) or b"{}")
        except ValueError:
            body = None
        text = (body.get("url") or body.get("text")) if isinstance(body, dict) else None
        if isinstance(text, list):          # a Shortcut can hand over a list
            text = next((x for x in text if isinstance(x, str)), None)
        if not isinstance(text, str) or not text.strip():
            return self.reply(400, {"ok": False, "result": "Paste a link first."})
        if not _opening.acquire(blocking=False):
            return self.reply(429, {"ok": False, "result": "The TV is still opening the last link."})
        try:
            used()
            res = links.open_link(text)
        finally:
            _opening.release()
        try:
            sent = links.normalise(text)[:300]
        except links.BadLink:
            sent = "(not a link)"
        print(f"{self.client_address[0]} /send {res.app or '-'} {'ok' if res.ok else 'refused'}: {sent}", flush=True)
        if not res.ok:
            print(f"  {res.message}", flush=True)
        self.reply(200 if res.ok else 400 if not res.app else 502, {"ok": res.ok, "result": res.message})

    def moments(self):
        """POST /moments: the Moments and the one playing; /moments/start {"id"}, /moments/stop:
        handed to the voice service, which plays them."""
        from couchbox import moments
        if self.path == "/moments":
            ms = moments.all()
            return self.reply(200, {"moments": [{"id": m["id"], "name": m["name"], "plays": moments.NAMES[m["app"]]} for m in ms],
                                    "active": moments.active_id()})
        try:
            body = json.loads(self.rfile.read(min(int(self.headers.get("Content-Length") or 0), 1024)) or b"{}")
        except ValueError:
            body = {}
        used()
        req = urllib.request.Request(VOICE + self.path, json.dumps({"id": str(body.get("id", ""))}).encode(),
                                     {"Content-Type": "application/json", "X-Couchbox": "1"}, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                res = json.load(r)
        except (OSError, ValueError):
            res = {"ok": False, "result": "The TV's voice service isn't running, and it plays Moments."}
        print(f"{self.client_address[0]} {self.path} {body.get('id', '')}: {'ok' if res.get('ok') else 'failed'}", flush=True)
        self.reply(200, {"ok": bool(res.get("ok")), "result": res.get("result") or "Done."})

    def do_POST(self):
        if not self.allowed():
            return
        if self.path == "/pair":
            return self.pair()
        if not self.paired():
            return
        if self.path == "/send":
            return self.send_link()
        if self.path in ("/moments", "/moments/start", "/moments/stop"):
            return self.moments()
        try:
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
            if self.path == "/type":
                result = type_text(str(body.get("text", ""))) if body.get("text") else "ok"
                if body.get("enter") and result != "searched":
                    press("enter")
            elif self.path == "/key":
                result = press(str(body.get("key", "")))
            else:
                return self.reply(404, {"result": "not found"})
            print(f"{self.client_address[0]} {self.path} {result}", flush=True)   # never log the text
            self.reply(200, {"result": "Sent." if result in ("ok", "typed") else "Searched YouTube." if result == "searched" else result})
        except Exception as err:
            self.reply(500, {"result": f"Error: {err}"})

    def log_message(self, *args):
        pass


def phone_base():
    """The address phones should use: https on the tailnet name (when Tailscale serves the
    page), else this box's mDNS name."""
    s = settings.load()
    if s["tailscale.enabled"] and s["tailscale.serve_phone_page"]:
        try:
            st = json.loads(subprocess.run(["tailscale", "status", "--self", "--json"], capture_output=True,
                                           text=True, timeout=10).stdout)
            name = (st.get("Self") or {}).get("DNSName", "").rstrip(".")
            if name and st.get("BackendState") == "Running":
                return f"https://{name}"
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
    return f"http://{s['network.hostname'] or socket.gethostname()}.local:{PORT}"


def phone_url():
    return f"{phone_base()}/#t={secrets.ensure_token()}"


def write_phone_qr():
    """Keep /run/couchbox/phone/phone.{url,png} pointing at this page, for the TV apps to show."""
    last = None
    while True:
        try:
            url = phone_url()
            if url != last:
                png = subprocess.run(["qrencode", "-t", "PNG", "-s", "12", "-m", "2", "-o", "-", url],
                                     capture_output=True, check=True).stdout
                for name, data in (("phone.png", png), ("phone.url", url.encode())):
                    tmp = os.path.join(PHONE_DIR, f".{name}")
                    with open(tmp, "wb") as f:
                        f.write(data)
                    os.chmod(tmp, 0o644)
                    os.replace(tmp, os.path.join(PHONE_DIR, name))
                print(f"phone page: {url.split('#', 1)[0]}", flush=True)   # never log the token
                last = url
        except (OSError, subprocess.CalledProcessError) as err:
            print(f"phone QR: {err}", flush=True)
        time.sleep(60)


# The typing pop-up for YouTube, Jellyfin and the web apps: while a text box or a search screen
# is open, a card with the phone page's QR code (and the mic hint) shows in the corner. It's put
# into each page over DevTools (and again after the page reloads).
HINT_JS = r"""(() => {
  const KEY = "__KEY__";
  if (window.__couchboxHint === KEY) return;
  const old = document.getElementById("couchbox-hint-host");
  if (old) old.remove();
  window.__couchboxHint = KEY;
  const host = document.createElement("div");
  host.id = "couchbox-hint-host";
  host.style.cssText = "position:fixed;z-index:2147483647;pointer-events:none;display:none;right:2vw;";
  const root = host.attachShadow({mode: "open"});
  const box = document.createElement("div");
  box.style.cssText = "display:flex;align-items:center;gap:1.2vw;padding:1vw 1.4vw 1vw 1vw;background:rgba(17,24,39,.95);" +
    "border:1px solid #374151;border-radius:1vw;box-shadow:0 .5vw 2vw rgba(0,0,0,.5);font-family:Inter,Roboto,sans-serif;color:#fff;";
  const qr = document.createElement("img");
  qr.src = "data:image/png;base64,__PNG__";
  qr.style.cssText = "width:8vw;height:8vw;background:#fff;padding:.4vw;border-radius:.6vw;image-rendering:pixelated;";
  const col = document.createElement("div");
  const line = (text, css) => { const d = document.createElement("div"); d.textContent = text; d.style.cssText = css; return d; };
  col.append(line("Type on your phone", "font-size:1.35vw;font-weight:600;"),
             line("__HOST__", "font-size:1vw;color:#9ca3af;margin-top:.3vw;"),
             line("or press the mic button and say it", "font-size:1vw;color:#d1d5db;margin-top:.7vw;"));
  box.append(qr, col);
  root.append(box);
  const editable = el => !!el && (el.isContentEditable || el.tagName === "TEXTAREA" ||
      el.tagName === "INPUT" && /^(text|search|email|url|tel|password|)$/i.test(el.getAttribute("type") || ""));
  const check = () => {
    if (!host.isConnected && document.documentElement) document.documentElement.appendChild(host);
    const yt = !!window._yttv;
    const show = yt ? /^#\/search/.test(location.hash) : editable(document.activeElement) || /^#!?\/search/.test(location.hash);
    host.style.display = show ? "block" : "none";
    host.style.top = yt ? "2vw" : "";
    host.style.bottom = yt ? "" : "2vw";
  };
  setInterval(check, 600);
  document.addEventListener("focusin", check, true);
  document.addEventListener("focusout", () => setTimeout(check, 50), true);
  window.addEventListener("hashchange", check);
  check();
})()"""


def hints():
    """Keep the typing pop-up in every YouTube, Jellyfin and web app page."""
    import base64
    while True:
        try:
            url = open(os.path.join(PHONE_DIR, "phone.url")).read().strip()
            png = base64.b64encode(open(os.path.join(PHONE_DIR, "phone.png"), "rb").read()).decode()
            js = (HINT_JS.replace("__KEY__", str(abs(hash(url))) + "-1").replace("__PNG__", png)
                  .replace("__HOST__", url.split("://", 1)[-1].split("/#", 1)[0]))
            for port in (cdp.YOUTUBE_PORT, cdp.WEB_PORT, cdp.JELLYFIN_PORT):
                for page in cdp.pages(port):
                    try:
                        cdp.evaluate(page, js, timeout=3)
                    except Exception:
                        pass
        except OSError:
            pass
        time.sleep(2)


class Server(ThreadingHTTPServer):
    address_family = socket.AF_INET6      # "::" also takes IPv4 (as ::ffff:a.b.c.d)
    daemon_threads = True


def main():
    if len(sys.argv) > 1:
        if sys.argv[1] == "--send" and len(sys.argv) == 3:
            res = links.open_link(sys.argv[2])
            print(res.message)
            sys.exit(0 if res.ok else 1)
        if sys.argv[1].startswith("-"):
            sys.exit(__doc__)
        time.sleep(0.5)                       # let the desktop pick up the new keyboard
        print(type_text(" ".join(sys.argv[1:])))
        return
    if not settings.get("phone.enabled"):
        print("couchbox-phone: turned off in Settings", flush=True)
        while True:
            time.sleep(3600)
    print(f"couchbox-phone: http://<this box>:{PORT}", flush=True)
    threading.Thread(target=write_phone_qr, daemon=True).start()
    threading.Thread(target=hints, daemon=True).start()
    Server(("::", PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
