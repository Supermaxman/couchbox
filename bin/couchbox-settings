#!/usr/bin/python3
"""couchbox-settings: Settings on the TV (the ⚙ tile). The QML talks to couchboxd through
couchbox.qtapp.Backend (JSON-RPC over its Unix socket) and follows its events.

  couchbox-settings
  couchbox-settings --demo                       against a fake system (no root, nothing changed)
  couchbox-settings --shot FILE --demo [--page network] [--in] [--keys down,ok] [--wait MS]
"""
import sys

from couchbox import qtapp

sys.exit(qtapp.run("couchbox-settings", "Settings", "settings/Main.qml"))
