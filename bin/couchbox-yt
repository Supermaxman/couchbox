#!/usr/bin/python3
"""couchbox-yt: YouTube as a native TV app (the YouTube tile, through couchbox-youtube-tv), built to
look and work like YouTube's own TV app: the guide on the left (Search, Home, Shorts, Music, Subscriptions, Library,
Gaming, News, Podcasts, Movies & TV, Live, Sports, Settings), shelves of videos, search with
suggestions, channel pages, and the player (libmpv, couchbox.player) with YouTube's controls and
the related videos under them.

Pages come from InnerTube as YouTube's TV client (couchbox.services.youtube); streams from yt-dlp
(couchbox.services.ytstream: H.264 up to 1080p60, no ads). The QML is in
/usr/share/couchbox/ui/youtube. VacuumTube stays installed as the tile's fallback (Settings →
Apps → YouTube app).

  couchbox-yt [--open video:ID[@SECONDS] | search:TEXT | channel:ID | browse:ID | home | profiles | signin]
                                     open on that (a second launch hands it to the running app)
  couchbox-yt --demo --shot FILE [--open ...] [--keys down,ok,...] [--profile guest | pick | demo1: | ...]
                                     render once off screen (made-up videos and profiles, no network;
                                     signed in as the first profile unless told otherwise; pick: start
                                     on Who's watching, as the app does with accounts on the TV)
Tests: COUCHBOX_MUTE=1 (no sound), COUCHBOX_NO_MPRIS=1 (don't take the remote's media keys).
"""
import json
import locale
import os
import sys
import threading
import traceback
from concurrent.futures import ThreadPoolExecutor

from couchbox import paths  # noqa: E402

QML = os.environ.get("COUCHBOX_YT_QML", str(paths.share() / "ui/youtube/Main.qml"))
TVKIT = os.environ.get("COUCHBOX_TVKIT", str(paths.share() / "ui"))
SITE = "yt"                                        # appctl socket, MPRIS name (couchbox_yt)
# The Pi's build of ffmpeg (HEVC hardware decoding), as couchbox-streaming uses: libmpv picks it
# up from LD_LIBRARY_PATH, which only counts at start, so start again with it.
RPI_FFMPEG = "/opt/couchbox/ffmpeg-rpi/lib"
if os.path.isdir(RPI_FFMPEG) and RPI_FFMPEG not in os.environ.get("LD_LIBRARY_PATH", ""):
    os.environ["LD_LIBRARY_PATH"] = RPI_FFMPEG + (":" + os.environ["LD_LIBRARY_PATH"] if os.environ.get("LD_LIBRARY_PATH") else "")
    os.execv(sys.executable, [sys.executable] + sys.argv)  # noqa: S606
# libmpv draws on Qt Quick's thread: the basic render loop (mpv deadlocks with the threaded one)
os.environ.setdefault("QSG_RENDER_LOOP", "basic")
os.environ["QML_XHR_ALLOW_FILE_READ"] = "1"         # the phone typing page's address

from PySide6.QtCore import QObject, QUrl, Signal, Slot  # noqa: E402
from PySide6.QtGui import QGuiApplication  # noqa: E402
from PySide6.QtNetwork import QNetworkAccessManager, QNetworkDiskCache  # noqa: E402
from PySide6.QtQml import QQmlApplicationEngine, QQmlNetworkAccessManagerFactory, qmlRegisterType  # noqa: E402
from PySide6.QtQuick import QQuickWindow, QSGRendererInterface  # noqa: E402

from couchbox.services import youtube, ytauth, ytextras, ytstream  # noqa: E402

SHOWN = ("home", "browse", "channel", "search", "subscriptions", "library")   # pages (for "screen")


class Backend(QObject):
    """QML's way to youtube.py, ytauth.py and ytstream.py: call(id, op, args) answers later with
    reply(id, json); event(name, json) tells it what happened meanwhile (a code was used)."""
    reply = Signal(int, str)
    event = Signal(str, str)

    def __init__(self, demo, profile=None):
        super().__init__()
        self.demo = demo
        self.yt = youtube.Demo(profile if profile is not None else "demo1:") if demo else youtube.YouTube()
        self.yt.on_event = lambda name, data: self.event.emit(name, json.dumps(data))
        self.pool = ThreadPoolExecutor(max_workers=6)
        if demo:                                     # a made-up TV's settings, fresh each time
            import tempfile
            self.settings = ytextras.Settings(tempfile.mkdtemp(prefix="couchbox-yt-demo-"))
        else:
            self.settings = ytextras.Settings(self.yt.dir)
        self.extras = ytextras.Extras()
        self.shown = {}                              # the last page the app asked for (the control socket's "screen")
        if not demo and self.settings.get()["cast"]:
            start_cast()                             # phones can cast to the TV (and launch the app) from now on
        if not demo:
            threading.Thread(target=ytstream.module, daemon=True).start()    # yt-dlp now: the first video starts sooner
            self.yt.auth.resume()                    # a code shown before the app last quit may still be entered
            self.pool.submit(self.yt.refresh_channels)

    def sign_in(self, op):
        """The device code for youtube.com/activate, with a QR code of it for a phone."""
        if self.demo:                                # a made-up code (and its picture)
            import tempfile
            qr = qr_png("https://www.google.com/device?user_code=KDX-PRW-TNQ", os.path.join(tempfile.gettempdir(), "couchbox-yt-demo-qr.png"))
            return {"state": "waiting", "code": "KDX-PRW-TNQ", "url": "youtube.com/activate", "qr": qr, "expires": 1800}
        a = self.yt.auth
        out = a.start() if op == "start" else a.code()
        if out.get("state") == "waiting":                # one file per code: a new code is a new picture
            path = os.path.join(self.yt.dir, f"activate-{out['code']}.png")
            if not os.path.exists(path):
                for f in os.listdir(self.yt.dir):
                    if f.startswith("activate-") and f.endswith(".png"):
                        os.remove(os.path.join(self.yt.dir, f))
                qr_png(out["full"], path)
            out["qr"] = path if os.path.exists(path) else ""
        return out

    def stream(self, vid, max_height=None):
        if self.demo:
            return youtube.demo_stream(vid)
        st = self.settings.get()
        cap = 2160 if st["unlock_resolution"] else ytstream.MAX_HEIGHT
        return ytstream.resolve(vid, h264=st["h264"], max_height=int(max_height or cap), superres=not st["remove_superres"])

    # the extras (ytextras): made up in the demo, else SponsorBlock, DeArrow, Return YouTube Dislike
    def segments(self, vid):
        if self.demo:                                # a sponsor read and an intro, the screenshots' video
            return {"segments": [{"category": "intro", "label": "Intro", "start": 0.0, "end": 12.0, "action": "skip"},
                                 {"category": "sponsor", "label": "Sponsor", "start": 1800.0, "end": 1860.0, "action": "skip"}]}
        segs = self.extras.segments(vid)
        skip = self.settings.get()["skip"]
        kinds = sorted({s["category"] for s in segs})
        print(f"yt {vid}: SponsorBlock: {len(segs)} segments ({', '.join(kinds) or 'none'}); "
              f"skipped here: {', '.join(k for k in kinds if skip.get(k)) or 'none'}", flush=True)
        return {"segments": segs}

    def branding(self, vid):
        if not self.settings.get()["dearrow"]:
            return {}
        if self.demo:
            return {"title": "A Made-Up Better Title"} if vid.endswith("3") else {}
        return self.extras.branding(vid)

    def votes(self, vid):
        if not self.settings.get()["dislikes"]:
            return {}
        return {"likes": 4300, "dislikes": 210} if self.demo else self.extras.votes(vid)

    def page(self, out):
        """A page as the settings want it: without Shorts if they're hidden."""
        return ytextras.hide_shorts(out) if self.settings.get()["hide_shorts"] else out

    def about(self):
        a = {"ytdlp": "demo", "ytdlpPath": "", "js": "demo"} if self.demo else ytstream.about()
        return dict(a, client=self.yt.client.get("clientVersion", ""))

    def run(self, op, a):
        y = self.yt
        ops = {
            "status": lambda: dict(y.profiles(), guide=[{"key": k, "label": label, "browse": b} for k, label, b in youtube.GUIDE],
                                   demo=self.demo, settings=self.settings.get()),
            "settings": lambda: self.settings.get(),
            "setting": lambda: self.settings.set(a["key"], a["value"]),
            "segments": lambda: self.segments(a["id"]),
            "branding": lambda: self.branding(a["id"]),
            "votes": lambda: self.votes(a["id"]),
            "castCode": lambda: cast_code(self.demo),
            "profiles": lambda: y.profiles(),
            "use": lambda: y.use(a.get("id", "")),
            "signInStart": lambda: self.sign_in("start"),
            "signInState": lambda: self.sign_in("state"),
            "signInCancel": lambda: (None if self.demo else y.auth.cancel(), {"ok": True})[1],
            "signOut": lambda: (None if self.demo else y.auth.remove(a["account"]), y.use("") if y.profile.get("account") == a["account"] else None,
                                {"ok": True})[2],
            "subscriptions": lambda: (lambda r: dict(r, page=self.page(r["page"])))(y.subscriptions()),
            "library": lambda: self.page(y.library()),
            "like": lambda: y.like(a["id"], a["status"]),
            "subscribe": lambda: y.subscribe(a["id"], bool(a["on"])),
            "notify": lambda: y.notify(a["params"], a.get("level", "")),
            "saveOptions": lambda: y.save_options(a["id"]),
            "save": lambda: y.save(a["id"], a["playlist"], bool(a["add"])),
            "report": lambda: y.report(a["id"], a["cpn"], a["event"], float(a.get("position", 0)), float(a.get("duration", 0))),
            "about": self.about,
            "home": lambda: self.page(y.home()),
            "browse": lambda: self.page(y.browse(a["id"], a.get("params", ""))),
            "more": lambda: self.page(y.more(a["token"])),
            "channel": lambda: self.page(y.channel(a["id"], a.get("params", ""))),
            "search": lambda: self.page((y.remember_search(a["q"]), y.search(a["q"]))[1]),
            "suggest": lambda: {"q": a["q"], "items": y.suggest(a["q"])},
            "searches": lambda: {"items": y.searches()},
            "watch": lambda: y.watch(a["id"]),
            "stream": lambda: self.stream(a["id"], a.get("max_height")),
            "comments": lambda: y.comments(a["token"]),
            "shorts": lambda: y.shorts(a.get("params", ""), a.get("token", "")),
            "short": lambda: y.short(a["id"]),
        }
        return ops[op]()

    @Slot(int, str, str)
    def call(self, rid, op, args):
        def work():
            try:
                a = json.loads(args or "{}")
                out = self.run(op, a)
                if op in SHOWN and isinstance(out, dict) and "error" not in out:
                    self.shown = {"op": op, "args": a, "page": out}
            except (ytstream.Unavailable, youtube.YouTubeError) as err:
                out = {"error": str(err.args[0]) if err.args else str(err)}
            except ytauth.SignedOut as err:
                out = {"error": str(err), "signedOut": True}
            except Exception as err:
                traceback.print_exc()
                out = {"error": "Couldn't reach YouTube." if "Connection" in type(err).__name__ else str(err) or err.__class__.__name__}
            self.reply.emit(rid, json.dumps(out))
        self.pool.submit(work)


def start_cast():
    """couchbox-yt-cast.service: the TV in the YouTube phone app's cast list. It keeps running
    after the app quits, so a phone can launch it."""
    import subprocess
    try:
        subprocess.run(["systemctl", "--user", "start", "--no-block", "couchbox-yt-cast.service"],  # noqa: S607
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5, check=False)
    except (OSError, subprocess.SubprocessError):
        pass


def cast_code(demo):
    """A "Link with TV code" (12 digits, in threes) from couchbox-yt-cast."""
    if demo:
        return {"code": "123 456 789 012", "name": "Couchbox YouTube (beta)"}
    from couchbox import appctl
    try:
        return appctl.call("yt-cast", {"op": "code"}, timeout=25)
    except appctl.NotRunning:
        start_cast()
        return {"error": "Casting is starting: try again in a moment."}


def qr_png(text, path):
    """A QR code (qrencode) as a PNG for the QML, or "" when there's no qrencode."""
    import subprocess
    try:
        subprocess.run(["qrencode", "-t", "PNG", "-s", "12", "-m", "2", "-o", path, text], check=True, timeout=10)
        return path
    except (OSError, subprocess.SubprocessError):
        return ""


class Control(QObject):
    """The control socket (couchbox.appctl): a second launch hands its --open to this one; the
    voice assistant, links sent to the TV, Continue watching and phones casting (couchbox-yt-cast)
    open videos, searches and channels, control what plays (media), read what's on screen (state,
    screen: the last page asked for) and use the app's own sign-in (call)."""
    command = Signal(str)

    def __init__(self, backend):
        super().__init__()
        self.backend = backend
        self.state = {"page": "starting"}
        self.focus = {}
        self.server = None

    def start(self):
        from couchbox import appctl
        try:
            self.server = appctl.Server(SITE, self.handle)
            self.server.start()
        except OSError as err:
            print(f"control socket: {err}", flush=True)

    @Slot(str)
    def setState(self, js):
        try:
            self.state = json.loads(js)
        except ValueError:
            pass

    @Slot(str)
    def setFocus(self, js):
        """What has the focus (Main, every 300 ms): for the "focus" op (ci/yt-box-check.sh)."""
        try:
            self.focus = json.loads(js)
        except ValueError:
            pass

    def handle(self, req):
        op = req.get("op")
        if op == "ping":
            return {"ok": True, "site": SITE}
        if op == "state":
            return dict(self.state, site="YouTube")
        if op == "focus":
            return dict(self.focus, page=self.state.get("page", ""))
        if op == "screen":                           # the voice assistant's "what's on screen"
            return dict(self.state, shown=self.backend.shown)
        if op == "call":
            return self.backend.run(req["fn"], req.get("args") or {})
        if op in ("open", "media"):
            self.command.emit(json.dumps(req))
            return {"ok": True}
        return {"error": f"unknown op {op}"}


def forward_to_running():
    """Already running: hand it this launch's --open (if any) and leave."""
    from couchbox import appctl
    if "--shot" in sys.argv or not appctl.running(SITE):
        return False
    target = sys.argv[sys.argv.index("--open") + 1] if "--open" in sys.argv else ""
    appctl.call(SITE, {"op": "open", "target": target})
    return True


# the remote's keys as couchbox-input sends them (uinput: KEY_ENTER is Return, the phone's Enter
# the keypad's), for --keys and the key filter
KEYS = {"up": "Key_Up", "down": "Key_Down", "left": "Key_Left", "right": "Key_Right", "ok": "Key_Return",
        "enter": "Key_Enter", "back": "Key_Escape", "play": "Key_MediaTogglePlayPause", "menu": "Key_Menu",
        "backspace": "Key_Backspace"}
TEXT = {"Key_Return": "\r", "Key_Enter": "\r", "Key_Escape": "\x1b", "Key_Backspace": "\b"}


class Shooter(QObject):
    """--shot: save the window to a PNG; --keys: the remote's presses as the box delivers them: a
    press, its release 50 ms later, the next key 300 ms on (couchbox-remote's gap); "ok@1.2" holds
    OK for 1.2 s with the compositor's repeats (after 0.5 s, every 40 ms); "t:sky" types on a
    keyboard; "wait:2" waits."""
    window = None
    GAP, TAP, DELAY, RATE = 300, 50, 500, 40

    @Slot(str)
    def save(self, path):
        from couchbox import qtcheck

        qtcheck.clipped(self.window)
        self.window.grabWindow().save(path)

    @Slot(str, str)
    def note(self, path, js):
        """--shot: what had the focus, beside the picture (FILE.focus.json)."""
        with open(path, "w") as f:
            f.write(js)

    def _send(self, kind, key, text="", repeat=False):
        from PySide6.QtCore import QCoreApplication, QEvent, Qt
        from PySide6.QtGui import QKeyEvent

        t = QEvent.KeyPress if kind == "press" else QEvent.KeyRelease
        QCoreApplication.sendEvent(self.window, QKeyEvent(t, getattr(Qt, key), Qt.NoModifier, text, repeat))

    @Slot(str, result=int)
    def run(self, keys):
        """Schedule the presses; returns how long they take (ms)."""
        from PySide6.QtCore import QTimer

        at = 0
        plan = []
        for name in [k for k in keys.split(",") if k]:
            if name.startswith("wait:"):
                at += int(float(name[5:]) * 1000)
                continue
            if name.startswith("t:"):
                for ch in name[2:]:
                    key = "Key_Space" if ch == " " else f"Key_{ch.upper()}"
                    plan += [(at, "press", key, ch, False), (at + self.TAP, "release", key, ch, False)]
                    at += self.TAP + 70
                at += self.GAP
                continue
            base, _, hold = name.partition("@")
            key = KEYS.get(base)
            if not key:
                continue
            text = TEXT.get(key, "")
            plan.append((at, "press", key, text, False))
            held = int(float(hold) * 1000) if hold else self.TAP
            r = self.DELAY
            while hold and r < held:            # held: the compositor's repeats, release + press pairs
                plan += [(at + r, "release", key, text, True), (at + r, "press", key, text, True)]
                r += self.RATE
            plan.append((at + held, "release", key, text, False))
            at += held + self.GAP
        for when, kind, key, text, repeat in plan:
            QTimer.singleShot(when, lambda k=kind, y=key, x=text, r=repeat: self._send(k, y, x, r))
        return at


class KeyFilter(QObject):
    """OK, Back and the other one-shot keys act once per press, on whatever had the focus when
    they went down: their repeats (held, or the compositor's) are dropped, and so is a release
    that arrives after the press moved the focus (the press that opened Search typed nothing,
    the press that opened a panel picked nothing in it)."""
    ONCE = ("Key_Return", "Key_Enter", "Key_Select", "Key_Escape", "Key_Back", "Key_Menu", "Key_MediaTogglePlayPause",
            "Key_MediaPlay", "Key_MediaPause")

    pressed = Signal()                               # any key (someone's there: no "Continue watching?")

    def __init__(self, window=None):
        from PySide6.QtCore import Qt

        super().__init__()
        self.window = window
        self.keys = {int(getattr(Qt, k)) for k in self.ONCE}
        self.down = {}

    def eventFilter(self, obj, ev):
        from PySide6.QtCore import QEvent

        if ev.type() == QEvent.KeyPress and not ev.isAutoRepeat():
            self.pressed.emit()
        if ev.type() not in (QEvent.KeyPress, QEvent.KeyRelease) or int(ev.key()) not in self.keys:
            return False
        if ev.isAutoRepeat():
            return True
        focus = self.window.activeFocusItem()
        if ev.type() == QEvent.KeyPress:
            self.down[int(ev.key())] = focus
            return False
        return self.down.pop(int(ev.key()), None) is not focus


class Network(QQmlNetworkAccessManagerFactory):
    """The QML's downloads (thumbnails, channel pictures), through a disk cache, so going back to a
    page doesn't fetch its pictures again."""

    def __init__(self):
        super().__init__()
        base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
        self.dir = os.path.join(base, "couchbox-yt", "network")
        self.lock = threading.Lock()
        self.made = 0

    def create(self, parent):                       # once per thread that loads things
        with self.lock:
            n, self.made = self.made, self.made + 1
        nam = QNetworkAccessManager(parent)
        cache = QNetworkDiskCache(nam)
        cache.setCacheDirectory(os.path.join(self.dir, str(n)))     # a cache isn't shared between threads
        cache.setMaximumCacheSize(96 * 1024 * 1024)
        nam.setCache(cache)
        return nam


def main():
    demo = "--demo" in sys.argv
    if "--shot" in sys.argv and "QT_QPA_PLATFORM" not in os.environ:
        os.environ["QT_QPA_PLATFORM"] = "offscreen"
    if os.environ.get("QT_QPA_PLATFORM") != "offscreen":
        QQuickWindow.setGraphicsApi(QSGRendererInterface.OpenGL)
    app = QGuiApplication(sys.argv)
    locale.setlocale(locale.LC_NUMERIC, "C")         # libmpv needs it
    if forward_to_running():
        sys.exit(0)
    app.setOrganizationName("couchbox")
    app.setApplicationName("couchbox-yt")
    app.setApplicationDisplayName("YouTube")
    app.setDesktopFileName("couchbox-yt")            # Wayland app id: matches couchbox-yt.desktop
    if os.environ.get("QT_QPA_PLATFORM") != "offscreen":
        from couchbox import player
        qmlRegisterType(player.MpvVideo, "CouchPlayer", 1, 0, "MpvVideo")
    else:                                            # no GPU off screen: a stand-in for the video
        os.environ["COUCHBOX_NO_VIDEO"] = "1"
    engine = QQmlApplicationEngine()
    network = Network()                              # kept: the engine doesn't own it
    if not demo:
        engine.setNetworkAccessManagerFactory(network)
    engine.addImportPath(TVKIT)
    if os.environ.get("COUCHBOX_NO_VIDEO"):
        engine.addImportPath(str(paths.share() / "ui/stubs"))
    profile = sys.argv[sys.argv.index("--profile") + 1] if "--profile" in sys.argv else None
    backend = Backend(demo, "" if profile == "guest" else profile)
    shooter = Shooter()
    control = Control(backend)
    if "--shot" not in sys.argv:
        control.start()
    ctx = engine.rootContext()
    ctx.setContextProperty("backend", backend)
    ctx.setContextProperty("control", control)
    ctx.setContextProperty("shooter", shooter)
    keyfilter = KeyFilter()
    ctx.setContextProperty("keyfilter", keyfilter)
    ctx.setContextProperty("demo", demo)
    ctx.setContextProperty("hasVideo", not os.environ.get("COUCHBOX_NO_VIDEO"))
    mpris = None
    if not os.environ.get("COUCHBOX_NO_VIDEO") and not os.environ.get("COUCHBOX_NO_MPRIS"):   # media keys arrive over MPRIS
        try:
            from couchbox import mpris as mpris_mod
            mpris = mpris_mod.Mpris(f"couchbox_{SITE}", "YouTube", "couchbox-yt")
        except Exception as err:
            print(f"MPRIS not available: {err}", flush=True)
    ctx.setContextProperty("mpris", mpris)
    engine.load(QUrl.fromLocalFile(QML))
    if not engine.rootObjects():
        sys.exit("Main.qml didn't load")
    shooter.window = engine.rootObjects()[0]
    keyfilter.window = shooter.window
    shooter.window.installEventFilter(keyfilter)
    code = app.exec()
    if control.server:
        control.server.close()
    backend.pool.shutdown(wait=False, cancel_futures=True)
    os._exit(code)                                   # don't wait for requests in flight


if __name__ == "__main__":
    main()
