#!/bin/sh
# couchbox-reels: the Reels app (every reel the box kept: Today at home, While you were out, the
# morning show's camera moments), started from its tile on the home row or Today at home's card
# (--open ID). It's couchbox-show's other face: the same player.
exec /usr/lib/couchbox/bin/couchbox-show --reels "$@"
