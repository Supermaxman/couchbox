#!/bin/sh
# couchbox-jellyfin: open Jellyfin on the TV.
# With couchbox-media installed (and Settings → Apps → Jellyfin player: native): Jellyfin
# Desktop using Raspberry Pi's FFmpeg, so HEVC plays on the Pi 5's hardware decoder (direct
# play, no work for the server). Otherwise the Jellyfin web app at the server set in Settings
# (the server converts video to H.264).
. /etc/couchbox/couchbox.env 2>/dev/null || true
app=/opt/couchbox/jellyfin-desktop/bin/jellyfin-desktop
if [ -x "$app" ] && [ "${COUCHBOX_MEDIA_JELLYFIN_CLIENT:-native}" = native ]; then
  # Already running (e.g. minimised by going Home): a second copy just exits without
  # showing the first, so bring the existing window back, full screen, with a KWin script.
  if pgrep -u "$(id -u)" -f "^$app" >/dev/null; then
    js=$(mktemp --suffix=.js)
    echo 'for (const w of workspace.windowList()) if (w.resourceClass == "org.jellyfin.JellyfinDesktop") { w.minimized = false; w.fullScreen = true; workspace.activeWindow = w; }' >"$js"
    name=couchbox-jellyfin-$$
    kwin() { gdbus call --session --dest org.kde.KWin "$@"; }
    id=$(kwin --object-path /Scripting --method org.kde.kwin.Scripting.loadScript "$js" "$name" | grep -o '[0-9]\+' | tail -1)
    [ -n "$id" ] && kwin --object-path "/Scripting/Script$id" --method org.kde.kwin.Script.run >/dev/null
    sleep 0.3
    kwin --object-path /Scripting --method org.kde.kwin.Scripting.unloadScript "$name" >/dev/null
    rm -f "$js"
    exit 0
  fi
  # Player settings measured on the Pi (dropped frames over 30 s of 4K HEVC):
  # - hardwareDecoding "enabled" (hwdec drm, no copy): "copy" dropped 715 of 900 frames
  # - mpv's fast scalers: the default high-quality ones still dropped 622 of 900
  # - Dolby Vision profile 5 and 10-bit H.264 go through the server (force_transcode_*)
  # - its CEC off: Jellyfin's libCEC took over the HDMI-CEC adapter and broke couchbox-tv
  # - an IPC socket for couchbox-jellyfin-stats and couchbox-playback
  # - when the server has to convert a video, HEVC first (Allow + Prefer transcode to H.265 put
  #   h265,hevc ahead of h264 in the device profile's transcoding codecs): the Pi decodes HEVC in
  #   hardware, H.264 only in software. Client side only: a server with HEVC encoding turned
  #   off still sends H.264.
  # - its own refresh-rate switching off: it changes modes through X11's XRandR, which under
  #   KWin's Wayland reaches Xwayland, not the TV. couchbox-playback matches the rate instead.
  # Settings → Display and sound (couchbox-playback jellyfin-conf): Night mode as an "af=" line of
  # mpv options (then live, through the socket); Surround sound passthrough as its HDMI device
  # type with the codecs the TV lists (from its next start: off while night mode is on)
  sock=$XDG_RUNTIME_DIR/mpv-jellyfin.sock
  oc="input-ipc-server=$sock
scale=bilinear
dscale=bilinear
cscale=bilinear
dither-depth=no
correct-downscaling=no
linear-downscaling=no
sigmoid-upscaling=no
deband=no
hdr-compute-peak=no"
  pb=$(/usr/lib/couchbox/bin/couchbox-playback jellyfin-conf 2>/dev/null) || pb='{"af": "", "passthrough": []}'
  af=$(printf '%s' "$pb" | jq -r '.af // ""')
  [ -z "$af" ] || oc="$oc
af=$af"
  for conf in "$HOME"/.local/share/jellyfin-desktop/*.conf "$HOME"/.local/share/jellyfin-desktop/*/*.conf; do
    [ -f "$conf" ] || continue
    case $conf in *jellyfin-desktop.conf) ;; *) continue ;; esac
    tmp=$(mktemp)
    jq --arg oc "$oc" '.sections.video.hardwareDecoding = "enabled" | .sections.video.force_transcode_dovi = true
      | .sections.video.force_transcode_hi10p = true | .sections.cec.enable = false | .sections.other.other_conf = $oc
      | .sections.video.allow_transcode_to_hevc = true | .sections.video.prefer_transcode_to_h265 = true
      | .sections.video["refreshrate.auto_switch"] = false
      | .sections.audio.devicetype = (if ($pb.passthrough | length) > 0 then "hdmi" else "basic" end)
      | reduce ("ac3", "eac3", "dts") as $c (.; .sections.audio["passthrough." + $c] = ($pb.passthrough | any(. == $c)))' \
      --argjson pb "$pb" "$conf" > "$tmp" && mv "$tmp" "$conf"
  done
  # DevTools on 127.0.0.1:9224 so couchbox-voice can drive it (search, play) as text
  QTWEBENGINE_REMOTE_DEBUGGING=127.0.0.1:9224
  export QTWEBENGINE_REMOTE_DEBUGGING
  # libmpv 0.41 leaks a GL fence (one file descriptor) per frame (see player.py). Our build
  # deletes them (media/build-jellyfin.sh); should one leak anyway, the default 8192 would
  # crash Jellyfin after ~6 minutes of video, the hard limit after hours.
  # shellcheck disable=SC3045  # dash (/bin/sh here) has ulimit -n and -H
  ulimit -n "$(ulimit -Hn)" 2>/dev/null || true
  # The TV's refresh rate follows its videos, and night mode follows Settings, until it quits
  # (this shell's PID becomes Jellyfin's with exec). Its messages go to the journal with ours.
  /usr/lib/couchbox/bin/couchbox-playback watch $$ --mpv "$sock" &
  LD_LIBRARY_PATH=/opt/couchbox/ffmpeg-rpi/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
  export LD_LIBRARY_PATH
  exec "$app" --fullscreen --tv "$@"
fi
url=${COUCHBOX_MEDIA_JELLYFIN_URL:-}
[ -n "$url" ] || { echo "Set the Jellyfin server in Settings → Apps and media." >&2; exec /usr/lib/couchbox/bin/couchbox-settings; }
exec flatpak run org.chromium.Chromium --app="$url" --start-fullscreen --class=couchbox-web-jellyfin --ozone-platform-hint=auto \
  --password-store=basic --autoplay-policy=no-user-gesture-required --no-default-browser-check --no-first-run \
  --remote-debugging-port=9223 --enable-spatial-navigation --load-extension="$HOME/.local/share/couchbox/web-extension"
