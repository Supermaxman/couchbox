#!/bin/sh
# couchbox-session-setup: the TV user's own settings that Plasma only reads from its home
# (no lock screen, no screen blanking, no KDE Wallet, the display-mode autostart, the
# session services). Run by the package's postinst; safe to re-run.
set -eu
U=tv
H=$(getent passwd "$U" | cut -d: -f6)
[ -n "$H" ] || exit 0
as() { runuser -u "$U" -- "$@"; }
put() {  # put <path under ~tv>: stdin, only when missing (so the user's own changes stay)
  [ -e "$H/$1" ] && { cat >/dev/null; return; }
  as mkdir -p "$(dirname "$H/$1")"; as tee "$H/$1" >/dev/null
}
put .config/kscreenlockerrc <<'X'
[Daemon]
Autolock=false
LockOnResume=false
X
put .config/powerdevilrc <<'X'
[AC][Display]
DimDisplayWhenIdle=false
TurnOffDisplayWhenIdle=false

[AC][SuspendAndShutdown]
AutoSuspendAction=0
X
put .config/kwalletrc <<'X'
[Wallet]
Enabled=false
First Use=false
X
as mkdir -p "$H/.config/autostart" "$H/.config/systemd/user/graphical-session.target.wants" "$H/.local/share/couchbox"
printf '[Desktop Entry]\nType=Application\nName=Couchbox display mode\nExec=/usr/lib/couchbox/bin/couchbox-display\nX-KDE-autostart-phase=1\n' \
  | as tee "$H/.config/autostart/couchbox-display.desktop" >/dev/null
printf '[Desktop Entry]\nType=Application\nName=Couchbox setup\nExec=/usr/lib/couchbox/bin/couchbox-setup --if-needed\nX-KDE-autostart-phase=2\n' \
  | as tee "$H/.config/autostart/couchbox-setup.desktop" >/dev/null
for u in couchbox-airplay.service couchbox-voice-overlay.service couchbox-mediakeys.service couchbox-frigate-popup.service couchbox-ontv.service couchbox-away.service couchbox-morning.service; do
  as ln -sfn "/usr/lib/systemd/user/$u" "$H/.config/systemd/user/graphical-session.target.wants/$u"
done
# (re)start the media keys, Frigate pop-up and On this TV services in a running TV session, so an
# update doesn't wait for the next login (they only remember what played last, which events popped
# up and where things were left; until they run, keys go to Plasma as before, nothing pops up and
# Continue watching keeps its last list)
R=/run/user/$(id -u "$U")
if [ -S "$R/bus" ]; then
  as env XDG_RUNTIME_DIR="$R" DBUS_SESSION_BUS_ADDRESS="unix:path=$R/bus" sh -c \
    'systemctl --user daemon-reload && systemctl --user restart couchbox-mediakeys.service couchbox-frigate-popup.service couchbox-ontv.service couchbox-away.service couchbox-morning.service' >/dev/null 2>&1 || true
fi
rm -rf "$H/.local/share/couchbox/web-extension"
cp -r /usr/share/couchbox/web-extension "$H/.local/share/couchbox/web-extension"
chown -R "$U:$U" "$H/.local/share/couchbox"
