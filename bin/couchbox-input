#!/usr/bin/env python3
"""couchbox-input: remap remote-control keys into keys the TV shell and apps understand.

Grabs input devices that match a section of the key map (/etc/couchbox/input.toml if the
household made one, else /usr/share/couchbox/input/<Settings → Remote → Key map>.toml), rewrites or drops
their keys, and re-emits everything through one virtual keyboard ("couchbox-input").
A key can also run a command instead, e.g. to control the TV: "run:couchbox-tv power" runs
once per press, "run-repeat:couchbox-tv volume-up" also keeps running while the key is held, and
"KEY_HOMEPAGE+run:couchbox-pause-all" sends the key and runs the command.
"mouse-mode" toggles mouse mode: the arrows move a pointer (faster the longer they're held),
OK clicks, Rewind and Fast-forward scroll; it switches itself off after 2 minutes unused.
"voice-or:KEY_ESC" (the Back button) first asks couchbox-voice to cancel: if the voice assistant
was busy or showing something, it's dismissed and the press ends there; otherwise KEY_ESC.
"media:playpause" (and play, pause, stop, next, previous, rewind, forward) goes to
couchbox-mediakeys, which plays or pauses whatever is playing (the app in front's player, else
the one playing, else the one paused last) over MPRIS; with nothing to control, or if that
service isn't running, the key itself goes on (Plasma's media controller, as before).
Devices come and go (Bluetooth remotes sleep), so the device list is rescanned
every few seconds. Every key press is logged (journalctl -u couchbox-input) with what it did,
and touches /run/couchbox/last-key (couchbox-memory reads it to tell whether the app in front is in use).

Some remote buttons never reach the kernel's input layer, e.g. the Fire TV remote's app
buttons, which only arrive as a vendor HID report (0xEF, an array of held button codes).
Sections can list such reports in hid_reports; their buttons are named "hid:<report>:<code>"
(e.g. hid:ef:a1), logged, and can be mapped like keys.

  couchbox-input              run the mapper (systemd: couchbox-input.service)
  couchbox-input --list       show input devices and which section matches each
  couchbox-input --monitor    print key presses from every keyboard-like device (no grab)
"""
import json
import os
import select
import shlex
import signal
import subprocess
import sys
import time
import tomllib
import urllib.request

from evdev import InputDevice, UInput, ecodes as e, list_devices

# "run:couchbox-tv power" and the like: Couchbox's helpers live next to this script
# (/usr/lib/couchbox/bin), which isn't on the service's PATH
os.environ["PATH"] = os.path.dirname(os.path.realpath(__file__)) + os.pathsep + os.environ.get("PATH", "/usr/bin:/bin")

def config_path():
    """The household's own map (/etc/couchbox/input.toml) if there is one, else the shipped
    map that Settings → Remote → Key map names (/usr/share/couchbox/input/<name>.toml)."""
    if os.environ.get("COUCHBOX_INPUT_CONFIG"):
        return os.environ["COUCHBOX_INPUT_CONFIG"]
    if os.path.exists("/etc/couchbox/input.toml"):
        return "/etc/couchbox/input.toml"
    try:
        from couchbox import paths, settings
        share, name = paths.share() / "input", settings.get("input.keymap")
    except Exception:  # noqa: BLE001 - never leave the remote unmapped over a settings problem
        from pathlib import Path
        share, name = Path("/usr/share/couchbox/input"), "default"
    return str(share / f"{name}.toml") if (share / f"{name}.toml").exists() else str(share / "default.toml")


CONFIG = config_path()
RESCAN_SECONDS = 3
LAST_KEY = "/run/couchbox/last-key"   # touched on every press: couchbox-memory's "someone is using the TV"
RUN_REPEAT_SECONDS = 0.25   # a held key re-runs its command at most this often
UINPUT_NAME = "couchbox-input"
MOUSE_NAME = "couchbox-input-mouse"
MOUSE_SPEED = (250, 1400)    # pointer speed in mouse mode, px/s: when an arrow is pressed, after MOUSE_RAMP
MOUSE_RAMP = 1.2             # seconds held to reach full speed
MOUSE_IDLE_OFF = 120         # mouse mode switches itself off after this long unused
MEDIA_ACTIONS = ("playpause", "play", "pause", "stop", "next", "previous", "rewind", "forward")
MEDIA_REPEAT_SECONDS = 0.4   # Rewind / Fast-forward held: another step this often


def keycode(name):
    name = name.upper()
    code = e.ecodes.get(name if name.startswith("KEY_") else "KEY_" + name)
    if code is None:
        sys.exit(f"{CONFIG}: unknown key {name!r}")
    return code


def load_sections(path):
    with open(path, "rb") as f:
        cfg = tomllib.load(f)
    sections = []
    for name, sec in cfg.get("device", {}).items():
        match = sec.get("match", {})
        if not match:
            sys.exit(f"{CONFIG}: [device.{name}] has no match")
        keymap, scanmap, hidmap = {}, {}, {}
        hid_reports = {int(str(r), 16) for r in sec.get("hid_reports", [])}
        for src, dst in sec.get("map", {}).items():
            if dst == "drop":
                target = None
            elif dst == "mouse-mode":
                target = ("mouse",)
            elif dst.startswith("voice-or:"):
                target = ("voice", keycode(dst.split(":", 1)[1]))
            elif dst.startswith("media:"):
                action = dst.split(":", 1)[1]
                if action not in MEDIA_ACTIONS:
                    sys.exit(f"{CONFIG}: unknown media action {action!r}")
                target = ("media", action, keycode(src) if src.upper().startswith("KEY_") else None)
            elif "+run:" in dst:                              # the key, and a command on press
                key, cmd = dst.split("+run:", 1)
                target = ("also", keycode(key), tuple(shlex.split(cmd)))
            elif dst.startswith(("run:", "run-repeat:")):
                kind, cmd = dst.split(":", 1)
                target = (kind == "run-repeat", tuple(shlex.split(cmd)))
            else:
                target = keycode(dst)
            if src.lower().startswith("hid:"):
                _, report, code = src.lower().split(":")
                hidmap[(int(report, 16), int(code, 16))] = target
                hid_reports.add(int(report, 16))
            elif src.lower().startswith("scan:"):
                scanmap[int(src[5:], 16)] = target   # raw HID usage, for keys the kernel can't name
            else:
                keymap[keycode(src)] = target
        sections.append((name, match, (keymap, scanmap, hidmap, hid_reports)))
    return sections


def matches(dev, match):
    if "vendor" in match:
        vendors = match["vendor"] if isinstance(match["vendor"], list) else [match["vendor"]]
        if dev.info.vendor not in {int(str(v), 16) for v in vendors}:
            return False
    if "product" in match and dev.info.product != int(str(match["product"]), 16):
        return False
    if "name_contains" in match and match["name_contains"].lower() not in dev.name.lower():
        return False
    return True


def has_keys(dev):
    return e.EV_KEY in dev.capabilities()


def open_devices():
    for path in list_devices():
        try:
            dev = InputDevice(path)
        except OSError:
            continue
        if dev.name in (UINPUT_NAME, MOUSE_NAME) or not has_keys(dev):
            dev.close()
            continue
        yield dev


def keyname(code):
    name = e.KEY.get(code, code)
    return name[-1] if isinstance(name, list) else name


def hidraw_for(dev):
    """The hidraw node of the HID device behind an evdev device, if any."""
    hid = os.path.realpath(f"/sys/class/input/{os.path.basename(dev.path)}/device/device")
    try:
        return "/dev/" + os.listdir(os.path.join(hid, "hidraw"))[0]
    except OSError:
        return None


def describe(dev):
    return f"{dev.path}  {dev.info.vendor:04x}:{dev.info.product:04x}  {dev.name!r}"


def cmd_list(sections):
    for dev in open_devices():
        hit = next((name for name, match, _ in sections if matches(dev, match)), "-")
        print(f"{describe(dev)}  section={hit}")
        dev.close()


def cmd_monitor():
    devs = {dev.fd: dev for dev in open_devices()}
    for dev in devs.values():
        print("watching", describe(dev))
    print("press remote buttons; Ctrl+C to stop")
    scan = {}
    while True:
        r, _, _ = select.select(list(devs), [], [])
        for fd in r:
            dev = devs[fd]
            for ev in dev.read():
                if ev.type == e.EV_MSC and ev.code == e.MSC_SCAN:
                    scan[fd] = ev.value   # the HID usage behind the next key event
                elif ev.type == e.EV_KEY and ev.value == 1:
                    name = e.KEY.get(ev.code, ev.code)
                    if isinstance(name, list):
                        name = name[-1]
                    code = f" (code {ev.code}, scan 0x{scan[fd]:x})" if fd in scan else f" (code {ev.code})"
                    print(f"{dev.info.vendor:04x}:{dev.info.product:04x} {dev.name!r}: {name}{code}", flush=True)


def voice_cancel():
    """Ask couchbox-voice to stop and hide; True if it was busy or showing something."""
    try:
        req = urllib.request.Request("http://127.0.0.1:8790/cancel", data=b"{}", method="POST", headers={"X-Couchbox": "1"})
        with urllib.request.urlopen(req, timeout=0.3) as r:
            return bool(json.load(r).get("cancelled"))
    except (OSError, ValueError):
        return False


def media_key(action):
    """Hand a media key to couchbox-mediakeys (the TV user's): {"player", "identity", "did",
    "why"}. "pass" when the key itself should go on: nothing to control, or the service isn't
    running (not when it was slow to answer: it may still have acted)."""
    try:
        from couchbox import appctl
    except ImportError as err:
        return {"player": None, "why": str(err), "pass": True}
    try:
        r = appctl.call("mediakeys", {"op": "key", "action": action}, timeout=2)
    except appctl.NotRunning:
        return {"player": None, "why": "couchbox-mediakeys isn't running", "pass": True}
    except Exception as err:  # noqa: BLE001 - logged with the key
        return {"player": None, "why": f"couchbox-mediakeys: {err.__class__.__name__} {err}".strip(), "pass": False}
    if not isinstance(r, dict):
        return {"player": None, "why": "couchbox-mediakeys: no answer", "pass": False}
    return dict(r, **{"pass": not r.get("player")})


def run(sections):
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)   # reap commands started by keys
    all_keys = [c for c in e.keys if isinstance(c, int) and 0 < c < 0x2ff]
    ui = UInput({e.EV_KEY: all_keys}, name=UINPUT_NAME)
    grabbed = {}   # fd -> (device, maps)
    hidraws = {}   # fd -> [path, (hidmap, hid_reports), {report: held codes}]
    last_scan = {}  # fd -> MSC_SCAN value of the event frame being read
    last_run = {}   # command -> when it last ran
    swallowed = set()  # voice-or keys whose press went to couchbox-voice (drop their release too)
    next_scan = 0.0
    # Mouse mode ("mouse-mode" button): the arrows move a pointer, OK clicks, Rewind and
    # Fast-forward scroll. For page controls that focus navigation can't reach.
    pointer = UInput({e.EV_REL: [e.REL_X, e.REL_Y, e.REL_WHEEL], e.EV_KEY: [e.BTN_LEFT, e.BTN_RIGHT]},
                     name=MOUSE_NAME)
    arrows = {e.KEY_LEFT: (-1, 0), e.KEY_RIGHT: (1, 0), e.KEY_UP: (0, -1), e.KEY_DOWN: (0, 1)}
    wheel = {e.KEY_REWIND: 1, e.KEY_FASTFORWARD: -1}
    mouse = {"on": False, "used": 0.0, "held": {}, "tick": 0.0, "frac": [0.0, 0.0]}

    def mouse_mode(on):
        mouse.update(on=on, used=time.monotonic(), held={})
        print(f"mouse mode {'on' if on else 'off'}", flush=True)
        if on:   # a nudge, so the pointer shows up where it is
            for d in (1, -1):
                pointer.write(e.EV_REL, e.REL_X, d)
                pointer.syn()

    def mouse_key(code, value):
        """Handle a key in mouse mode; False if mouse mode doesn't use it."""
        now = time.monotonic()
        if code in arrows:
            if value == 1:
                mouse["held"][code] = now
                mouse["tick"] = now
                dx, dy = arrows[code]
                pointer.write(e.EV_REL, e.REL_X if dx else e.REL_Y, (dx or dy) * 6)   # a tap moves a little
                pointer.syn()
            elif value == 0:
                mouse["held"].pop(code, None)
        elif code == e.KEY_ENTER:
            if value in (0, 1):
                pointer.write(e.EV_KEY, e.BTN_LEFT, value)
                pointer.syn()
        elif code in wheel:
            if value in (1, 2):
                pointer.write(e.EV_REL, e.REL_WHEEL, wheel[code])
                pointer.syn()
        else:
            return False
        mouse["used"] = now
        return True

    def mouse_move():
        """Move the pointer for the arrows being held (called about 60 times a second)."""
        now = time.monotonic()
        dt, mouse["tick"] = now - mouse["tick"], now
        for code, since in mouse["held"].items():
            lo, hi = MOUSE_SPEED
            speed = lo + (hi - lo) * min(1.0, (now - since) / MOUSE_RAMP)
            for axis, d in enumerate(arrows[code]):
                mouse["frac"][axis] += d * speed * dt
        step = [int(f) for f in mouse["frac"]]
        mouse["frac"] = [f - s for f, s in zip(mouse["frac"], step)]
        if step[0]:
            pointer.write(e.EV_REL, e.REL_X, step[0])
        if step[1]:
            pointer.write(e.EV_REL, e.REL_Y, step[1])
        if any(step):
            pointer.syn()
        mouse["used"] = now

    def act(target, value, label):
        """Do what a key (or HID button) is mapped to; value 1 = press, 2 = repeat, 0 = release."""
        if value == 1:
            try:
                open(LAST_KEY, "a").close()
                os.utime(LAST_KEY)
            except OSError:
                pass
        if target == ("mouse",):
            if value == 1:
                mouse_mode(not mouse["on"])
            return
        if mouse["on"] and isinstance(target, int) and mouse_key(target, value):
            if value == 1:
                print(f"key {label} -> mouse", flush=True)
            return
        if isinstance(target, tuple) and target[0] == "also":
            _, code, cmd = target
            if value == 1:
                print(f"key {label} -> {keyname(code)} + run {' '.join(cmd)}", flush=True)
                try:
                    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, start_new_session=True)
                except OSError as err:
                    print(f"cannot run {' '.join(cmd)}: {err}", flush=True)
            ui.write(e.EV_KEY, code, value)
            ui.syn()
            return
        if isinstance(target, tuple) and target[0] == "media":
            _, action, code = target
            if mouse["on"] and code is not None and mouse_key(code, value):   # Rewind / FF scroll
                if value == 1:
                    print(f"key {label} -> mouse", flush=True)
                return
            t = time.monotonic()
            held = value == 2 and action in ("rewind", "forward") and t - last_run.get(action, 0) >= MEDIA_REPEAT_SECONDS
            if value != 1 and not held:
                return
            last_run[action] = t
            r = media_key(action)
            if r.get("player"):
                if value == 1:
                    print(f"key {label} -> {action}: {r.get('did')} {r.get('identity') or r['player']} ({r.get('why')})", flush=True)
                return
            if value == 1 and not r["pass"]:
                print(f"key {label} -> {action}: {r.get('why')}", flush=True)
            elif value == 1:   # nothing to control: the key itself, as before
                print(f"key {label} -> {keyname(code) if code is not None else 'dropped'} ({r.get('why')})", flush=True)
                if code is not None:
                    for v in (1, 0):
                        ui.write(e.EV_KEY, code, v)
                        ui.syn()
            return
        if isinstance(target, tuple) and target[0] == "voice":
            code = target[1]
            if value == 1 and voice_cancel():
                swallowed.add(code)
                print(f"key {label} -> dismissed the voice assistant", flush=True)
                return
            if code in swallowed:
                if value == 0:
                    swallowed.discard(code)
                return
            target = code
        if isinstance(target, tuple):
            repeat, cmd = target
            t = time.monotonic()
            if value == 1 or (repeat and value == 2 and t - last_run.get(cmd, 0) >= RUN_REPEAT_SECONDS):
                last_run[cmd] = t
                if value == 1:
                    print(f"key {label} -> run {' '.join(cmd)}", flush=True)
                try:
                    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, start_new_session=True)
                except OSError as err:
                    print(f"cannot run {' '.join(cmd)}: {err}", flush=True)
        elif target is not None:
            if value == 1:
                print(f"key {label} -> {keyname(target)}", flush=True)
            ui.write(e.EV_KEY, target, value)
            ui.syn()
        elif value == 1:
            print(f"key {label} -> dropped", flush=True)

    while True:
        now = time.monotonic()
        if now >= next_scan:
            known = {dev.path for dev, _ in grabbed.values()}
            for dev in open_devices():
                if dev.path in known:
                    dev.close()
                    continue
                hit = next(((n, km) for n, m, km in sections if matches(dev, m)), None)
                if hit is None:
                    dev.close()
                    continue
                try:
                    dev.grab()
                except OSError as err:
                    print(f"cannot grab {describe(dev)}: {err}", flush=True)
                    dev.close()
                    continue
                grabbed[dev.fd] = (dev, hit[1])
                print(f"grabbed {describe(dev)} as [{hit[0]}]", flush=True)
                hidmap, hid_reports = hit[1][2], hit[1][3]
                raw = hidraw_for(dev) if hid_reports else None
                if raw and raw not in {h[0] for h in hidraws.values()}:
                    try:
                        fd = os.open(raw, os.O_RDONLY | os.O_NONBLOCK)
                        hidraws[fd] = [raw, (hidmap, hid_reports), {}]
                        print(f"reading {raw} for HID reports {', '.join(f'{r:02x}' for r in sorted(hid_reports))}", flush=True)
                    except OSError as err:
                        print(f"cannot open {raw}: {err}", flush=True)
            next_scan = now + RESCAN_SECONDS

        if mouse["on"] and not mouse["held"] and now - mouse["used"] > MOUSE_IDLE_OFF:
            mouse_mode(False)
        wait = 1 / 60 if mouse["held"] else RESCAN_SECONDS
        ready, _, _ = select.select(list(grabbed) + list(hidraws), [], [], wait)
        if mouse["held"]:
            mouse_move()
        for fd in ready:
            if fd in hidraws:
                path, (hidmap, hid_reports), held = hidraws[fd]
                try:
                    report = os.read(fd, 256)
                except BlockingIOError:
                    continue
                except OSError:
                    print(f"lost {path}", flush=True)
                    os.close(fd)
                    del hidraws[fd]
                    continue
                if not report or report[0] not in hid_reports:
                    continue
                now_held = {c for c in report[1:] if c}
                before = held.get(report[0], set())
                for code in sorted(now_held - before):
                    act(hidmap.get((report[0], code)), 1, f"hid:{report[0]:02x}:{code:02x}")
                for code in sorted(before - now_held):
                    act(hidmap.get((report[0], code)), 0, f"hid:{report[0]:02x}:{code:02x}")
                held[report[0]] = now_held
                continue
            dev, maps = grabbed[fd]
            try:
                events = list(dev.read())
            except OSError:
                print(f"lost {dev.path}", flush=True)
                del grabbed[fd]
                continue
            keymap, scanmap = maps[0], maps[1]
            for ev in events:
                if ev.type == e.EV_MSC and ev.code == e.MSC_SCAN:
                    last_scan[fd] = ev.value
                elif ev.type == e.EV_KEY:
                    sc = last_scan.get(fd)
                    if sc is not None and sc in scanmap:
                        target = scanmap[sc]
                    else:
                        target = keymap.get(ev.code, ev.code)
                    scan = f" scan 0x{sc:x}" if sc is not None else ""
                    act(target, ev.value, f"{dev.name!r} {keyname(ev.code)}{scan}")
                elif ev.type == e.EV_SYN:
                    ui.syn()
                    last_scan.pop(fd, None)


def main():
    sections = load_sections(CONFIG)
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--list":
        cmd_list(sections)
    elif arg == "--monitor":
        cmd_monitor()
    elif arg == "":
        run(sections)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
