#!/usr/bin/python3
"""couchbox-yt-cast: the TV as a cast target for the YouTube phone app (couchbox.services.ytcast):
found on the Wi-Fi (DIAL), launched and paired from the phone, and then told what to play over
YouTube's Lounge. It drives couchbox-yt through its control socket (it starts the app when a
phone casts and it isn't running) and reports back what plays.

Run by couchbox-yt-cast.service (couchbox-yt starts it). Until the native app replaces
VacuumTube it shows up under its own name, "Couchbox YouTube (beta)", beside VacuumTube's.
Its screen id (which phones remember) is kept in ~/.local/share/couchbox-yt/cast.json.
  couchbox-yt-cast            run
  couchbox-yt-cast --code     print a "Link with TV code" pairing code (12 digits) and leave
"""

import json
import logging
import os
import subprocess
import sys
import threading
import time
import uuid

from couchbox import appctl
from couchbox.services import ytcast

NAME = os.environ.get("COUCHBOX_YT_CAST_NAME", "Couchbox YouTube (beta)")
DIR = os.path.expanduser("~/.local/share/couchbox-yt")
STATE_FILE = os.path.join(DIR, "cast.json")
APP = "yt"
log = logging.getLogger("couchbox-yt-cast")


def load_state():
    try:
        with open(STATE_FILE) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = {}
    if not st.get("udn"):
        st["udn"] = str(uuid.uuid4())
    if not st.get("device"):
        st["device"] = str(uuid.uuid4())
    return st


def save_state(st):
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(st, f)
    os.replace(tmp, STATE_FILE)


def app_running():
    return appctl.running(APP)


def app_state():
    try:
        return appctl.call(APP, {"op": "state"}, timeout=3)
    except Exception:  # noqa: BLE001
        return {}


def app_open(target):
    """Show target in the app (video:ID@SECONDS, home...), starting the app if it isn't running."""
    if app_running():
        appctl.call(APP, {"op": "open", "target": target}, timeout=5)
        return
    unit = f"app-couchbox-yt@cast-{uuid.uuid4().hex[:8]}.service"
    subprocess.run(["systemd-run", "--user", "--quiet", "--collect", f"--unit={unit}", "--",
                    "/usr/lib/couchbox/bin/couchbox-yt", "--open", target], check=False)
    for _ in range(40):
        if app_running():
            return
        time.sleep(0.5)


def app_media(action, seconds=None):
    req = {"op": "media", "action": action}
    if seconds is not None:
        req["seconds"] = seconds
    try:
        appctl.call(APP, req, timeout=5)
    except Exception as err:  # noqa: BLE001
        log.warning("couldn't %s: %s", action, err)


def volume(set_to=None):
    """The TV's volume (0-100) and mute, through PipeWire (wpctl)."""
    sink = "@DEFAULT_AUDIO_SINK@"
    if set_to is not None:
        subprocess.run(["wpctl", "set-volume", sink, f"{max(0, min(100, int(set_to))) / 100:.2f}"], check=False)
    out = subprocess.run(["wpctl", "get-volume", sink], capture_output=True, text=True, check=False).stdout
    try:
        vol = round(float(out.split()[1]) * 100)
    except (IndexError, ValueError):
        vol = 100
    return vol, "MUTED" in out


class Receiver:
    def __init__(self):
        self.st = load_state()
        self.lounge = ytcast.Lounge(NAME, self.st.get("screen", ""), self.st["device"])
        self.lounge.on_command = self.command
        self.queue = {"videoIds": [], "index": 0, "listId": ""}
        self.playing = ""               # the cast video's id
        self.last = None                # the last state reported (to report only changes)

    def screen_id(self):
        sid = self.lounge.ensure_screen()
        if self.st.get("screen") != sid:
            self.st["screen"] = sid
            save_state(self.st)
        return sid

    # the phone's commands
    def command(self, name, args):
        if name in ("setPlaylist", "setVideo", "updatePlaylist") and (args.get("videoId") or args.get("videoIds")):
            p = ytcast.playlist(args)
            self.queue = {"videoIds": p["videoIds"], "index": p["index"], "listId": p["listId"]}
            if name != "updatePlaylist" or not self.playing:
                self.play(p["videoId"], p["start"])
        elif name == "play":
            app_media("play")
        elif name == "pause":
            app_media("pause")
        elif name == "seekTo":
            app_media("seek", float(args.get("newTime") or 0))
        elif name in ("next", "previous"):
            ids, i = self.queue["videoIds"], self.queue["index"] + (1 if name == "next" else -1)
            if 0 <= i < len(ids):
                self.queue["index"] = i
                self.play(ids[i], 0)
        elif name == "stopVideo":
            app_media("pause")
            self.playing = ""
            app_open("home")
        elif name == "setVolume":
            vol, muted = volume(args.get("volume"))
            self.lounge.send(("onVolumeChanged", {"volume": vol, "muted": str(muted).lower()}))
        elif name == "getVolume":
            vol, muted = volume()
            self.lounge.send(("onVolumeChanged", {"volume": vol, "muted": str(muted).lower()}))
        elif name == "getNowPlaying":
            self.report(force=True)
        elif name == "getDiscoveryDeviceId":
            self.lounge.send(("discoveryDeviceId", {"discoveryDeviceId": self.st["device"]}))
        elif name == "remoteConnected":
            log.info("a phone joined")
        elif name == "remoteDisconnected":
            log.info("a phone left")

    def play(self, vid, start):
        if not vid:
            return
        self.playing = vid
        log.info("cast: video %s at %d s", vid, int(start))
        app_open(f"video:{vid}@{int(start)}" if start >= 1 else f"video:{vid}")
        self.last = None
        self.report(force=True)

    # back to the phone: what plays and how
    def report(self, force=False):
        st = app_state() if app_running() else {}
        vid = st.get("videoId") or ""
        if not self.playing and not force:
            return
        state = ytcast.STATE["paused"] if st.get("paused") else ytcast.STATE["playing"] if vid else ytcast.STATE["unstarted"]
        pos, dur = float(st.get("position") or 0), float(st.get("duration") or 0)
        now = (vid, state, round(pos))
        if not force and self.last and now[:2] == self.last[:2] and abs(now[2] - self.last[2]) < 3:
            self.last = now
            return
        changed_video = not self.last or self.last[0] != vid
        self.last = now
        common = {"currentTime": pos, "duration": dur, "state": state, "cpn": "couchbox", "loadedTime": dur,
                  "seekableStartTime": 0, "seekableEndTime": dur}
        if changed_video or force:
            self.lounge.send(("nowPlaying", dict(common, videoId=vid or self.playing, listId=self.queue["listId"],
                                                 currentIndex=self.queue["index"])))
        else:
            self.lounge.send(("onStateChange", common))

    def follow(self):
        while True:
            time.sleep(1.5)
            try:
                if self.playing:
                    self.report()
            except Exception:  # noqa: BLE001
                log.exception("report")

    # DIAL: the phone launches us with a pairing code
    def launch(self, params):
        code = params.get("pairingCode") or ""
        if not app_running():
            app_open("home")
        else:
            try:
                appctl.call(APP, {"op": "open", "target": ""}, timeout=5)   # in front
            except Exception:  # noqa: BLE001
                pass
        if code:
            try:
                self.lounge.register(code)
                log.info("a phone paired (DIAL)")
            except Exception as err:  # noqa: BLE001
                log.warning("pairing failed: %s", type(err).__name__)

    def stop_app(self):
        app_media("pause")

    def control(self, req):
        op = req.get("op")
        if op == "ping":
            return {"ok": True, "site": "yt-cast", "name": NAME}
        if op == "code":
            code = self.lounge.pairing_code()
            return {"code": " ".join(code[i:i + 3] for i in range(0, 12, 3)), "name": NAME}
        return {"error": f"unknown op {op}"}

    def run(self):
        self.screen_id()
        dial = ytcast.Dial(NAME, self.st["udn"], self.screen_id, app_running, self.launch, self.stop_app)
        threading.Thread(target=dial.serve_ssdp, daemon=True, name="ssdp").start()
        threading.Thread(target=dial.serve_http, daemon=True, name="dial").start()
        threading.Thread(target=self.follow, daemon=True, name="follow").start()
        server = appctl.Server("yt-cast", self.control)
        server.start()
        log.info("casting: ready as %s (DIAL on port %d)", NAME, ytcast.HTTP_PORT)
        self.lounge.run()


def main():
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    r = Receiver()
    if "--code" in sys.argv:
        print(r.control({"op": "code"})["code"])
        return
    r.run()


if __name__ == "__main__":
    main()
