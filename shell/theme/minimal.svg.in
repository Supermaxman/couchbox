<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <!-- couchbox wallpaper "@NAME@" (minimal): a dark base with two faint glows and fine grain
       (the grain stops gradient banding on the TV). Rendered by couchbox-theme. -->
  <defs>
    <linearGradient id="base" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="@BG_HORIZON@"/>
      <stop offset="1" stop-color="@BG_TOP@"/>
    </linearGradient>
    <radialGradient id="glow1" cx="0.18" cy="0.05" r="0.75">
      <stop offset="0" stop-color="@SUN_TOP@" stop-opacity="0.9"/>
      <stop offset="1" stop-color="@SUN_TOP@" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glow2" cx="0.92" cy="1.0" r="0.7">
      <stop offset="0" stop-color="@SUN_BOTTOM@" stop-opacity="0.75"/>
      <stop offset="1" stop-color="@SUN_BOTTOM@" stop-opacity="0"/>
    </radialGradient>
    <filter id="grain" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7"/>
      <feColorMatrix type="saturate" values="0"/>
    </filter>
  </defs>
  <rect width="1920" height="1080" fill="url(#base)"/>
  <rect width="1920" height="1080" fill="url(#glow1)"/>
  <rect width="1920" height="1080" fill="url(#glow2)"/>
  <rect width="1920" height="1080" filter="url(#grain)" opacity="0.035"/>
</svg>
